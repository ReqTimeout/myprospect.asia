---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Dock from '../components/islands/Dock.svelte';
import WaPopup from '../components/islands/WaPopup.svelte';
import TickerRibbon from '../components/TickerRibbon.astro';
import Chapter from '../components/Chapter.astro';
import SportBranches from '../components/SportBranches.astro';
import PartnersSection from '../components/PartnersSection.astro';
import SportArt from '../components/SportArt.astro';
import StatsBar from '../components/StatsBar.astro';
import AboutSection from '../components/AboutSection.astro';
import LevelJourney from '../components/islands/LevelJourney.svelte';
import ProgramSection from '../components/ProgramSection.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import Testimonials from '../components/islands/Testimonials.svelte';
import CoachesSection from '../components/CoachesSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { waLink } from '../lib/wa';
import { testimonials } from '../data/testimonials';
import { faqs } from '../data/faq';
import { organizationSchema, faqSchema } from '../lib/seo';

const schema = [organizationSchema, faqSchema(faqs)];
---

<Base
  title="Prospect Asia — Jadi Atlet Modern | Sports Communication Program"
  schema={schema}
>
  <Header />

  <main>
    <section class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 pt-14 pb-24 text-center sm:px-6">
      <div
        class="art-blob -top-32 -right-24 h-96 w-96"
        style="background: radial-gradient(circle, rgba(255,122,26,0.22), transparent 68%);"
        aria-hidden="true"
      ></div>
      <div
        class="art-blob top-1/3 -left-32 h-80 w-80"
        style="background: radial-gradient(circle, rgba(255,195,46,0.28), transparent 68%); animation-delay: -8s;"
        aria-hidden="true"
      ></div>
      <div class="art-dots absolute inset-0 [mask-image:linear-gradient(to_bottom,transparent,black_55%,transparent)]" aria-hidden="true"></div>
      <div class="pat-halftone absolute -top-28 -left-28 h-96 w-96 opacity-55 pat-fade-tr" style="--pat-gap: 8px" aria-hidden="true"></div>
      <div class="pat-noise absolute inset-0" aria-hidden="true"></div>
      <div class="hero-glow absolute inset-0" aria-hidden="true"></div>
      <div class="art-pitch absolute inset-x-0 bottom-0 h-[70%] opacity-60 [mask-image:linear-gradient(to_top,black,transparent)]" aria-hidden="true"></div>
      <div class="sport-ball sport-ball--orange -left-6 top-[38%] hidden h-12 w-12 animate-float lg:block" aria-hidden="true"></div>
      <div class="sport-ball right-[4%] top-[22%] hidden h-8 w-8 animate-float-slow xl:block" aria-hidden="true"></div>
      <div data-parallax="-30" class="pointer-events-none absolute top-24 left-[8%] hidden animate-float -rotate-12 rounded-2xl border-3 border-ink/10 bg-white px-4 py-2 shadow-soft sm:block" aria-hidden="true">
        <span class="display text-lg text-ink">SPEAK LOUD!</span>
      </div>
      <div data-parallax="24" class="pointer-events-none absolute right-[7%] bottom-40 hidden animate-float-slow rotate-6 rounded-full border-3 border-brand/25 bg-brand-soft px-5 py-2 sm:block" aria-hidden="true">
        <span class="text-sm font-black text-brand-dark">2.175+ atlet</span>
      </div>
      <div class="pointer-events-none absolute top-1/2 left-[12%] hidden h-4 w-4 rotate-45 rounded-sm bg-crimson sm:block" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-[14%] top-56 hidden h-3 w-3 rounded-full bg-gold sm:block" aria-hidden="true"></div>

      <p data-hero="badge" class="relative z-10 mb-5 inline-block rounded-full border border-brand/30 bg-brand/10 px-4 py-1.5 text-[11px] font-bold tracking-[0.2em] text-brand-dark uppercase sm:text-xs">
        #JadiAtletModern
      </p>

      <h1 data-hero="title" class="display relative z-10 text-[12vw] leading-[0.92] sm:text-6xl md:text-7xl lg:text-8xl">
        Jadi Atlet<br />
        <span class="hl-brand">Modern</span> dengan<br />
        Sports Communication
      </h1>

      <p data-hero="sub" class="relative z-10 mt-5 max-w-md text-sm leading-relaxed text-ink/70 sm:text-base">
        Public speaking &amp; bahasa Inggris khusus atlet — biar suaramu sekuat performamu.
        Online, fleksibel, didampingi coach berpengalaman.
      </p>

      <div class="relative z-10 mt-8 w-full max-w-lg sm:max-w-2xl">
        <img
          src="/media/athletes-cutout.webp"
          alt="Delapan atlet lintas cabang berprestasi membawa piala — wajah atlet modern Prospect Asia"
          width="910"
          height="405"
          fetchpriority="high"
          data-hero="photo"
          class="w-full drop-shadow-[0_28px_50px_rgba(36,26,18,0.25)]"
        />
      </div>

      <a
        href={waLink({ source: 'hero' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="hero"
        data-register
        data-source="hero"
        data-magnetic
        data-hero="cta"
        class="btn-pop relative z-10 mt-7 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-ink uppercase shadow-[0_18px_40px_-14px_rgba(255,122,26,0.65)] hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
      >
        Daftar Sekarang
        <span aria-hidden="true">↗</span>
      </a>
      <p class="relative z-10 mt-3 text-xs text-ink/50">Isi formulir 30 detik · admin balas di jam kerja</p>
      <div class="relative z-10 mt-10 flex flex-col items-center gap-1.5 text-ink/40" aria-hidden="true">
        <span class="text-[10px] font-bold tracking-[0.25em] uppercase">Scroll</span>
        <span class="scroll-hint block h-9 w-5 rounded-full border-2 border-ink/25 pt-1.5">
          <span class="block h-1.5 w-1.5 rounded-full bg-brand"></span>
        </span>
      </div>
    </section>

    <TickerRibbon
      items={[
        'Sports Communication',
        'Public Speaking',
        'English for Athletes',
        'Media Interview',
        'Personal Branding',
        'Jalur Atlet Modern',
      ]}
      speed={34}
      tone="ink"
    />

    <div class="surface-warm">
      <SportBranches />
    </div>

    <div class="surface-hair">
      <PartnersSection />
    </div>

    <div class="surface-ink">
      <StatsBar />
    </div>

    <AboutSection />

    <div class="surface-warm">
      <section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
        <SportArt variant="net" stroke="#ff7a1a" opacity={0.1} class="absolute inset-0 h-full w-full [mask-image:linear-gradient(to_bottom_right,black,transparent_70%)]" />
        <div class="pat-grid absolute inset-0 opacity-55 [mask-image:linear-gradient(to_top_left,transparent,black_60%)]" aria-hidden="true"></div>
        <div class="art-ring left-6 top-14 hidden h-16 w-16 border-gold/40 sm:block" aria-hidden="true"></div>
        <div class="art-diamond top-10 right-10 h-3 w-3 bg-crimson/50 hidden sm:block" aria-hidden="true"></div>

        <Chapter num="04" label="Level & Journey" class="mb-6" />

        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="display text-5xl leading-[0.9] sm:text-6xl lg:text-7xl">
              Dari nol sampai<br />
              <span class="relative inline-block">
                <span class="hl-swash text-ink">siap panggung</span>
              </span>
            </h2>
          </div>
          <p class="max-w-xs pt-6 text-sm leading-relaxed text-ink/60 sm:pt-8">
            Tiga level, satu jalur: dasar, berkembang, lalu tampil di depan publik.
          </p>
        </div>
        <div class="card-soft relative overflow-hidden rounded-3xl p-6 sm:p-8">
          <SportArt variant="court" stroke="#241a12" opacity={0.08} class="absolute inset-0 h-full w-full [mask-image:linear-gradient(to_bottom_right,black,transparent_60%)]" />
          <div class="relative">
            <LevelJourney client:visible />
          </div>
        </div>
      </section>
    </div>

    <div class="surface-ink">
      <ProgramSection />
    </div>

    <WorkshopSection />

    <div class="surface-warm">
      <section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
        <div class="art-blob -top-20 right-[-6rem] h-64 w-64" style="background: radial-gradient(circle, rgba(255,195,46,0.16), transparent 68%);" aria-hidden="true"></div>
        <div class="pat-halftone absolute -bottom-24 -left-24 h-72 w-72 opacity-45 pat-fade-tr" style="--pat-gap: 8px" aria-hidden="true"></div>

        <Chapter num="07" label="Testimoni" class="mb-6" />

        <div class="mb-8">
          <h2 class="display text-5xl sm:text-6xl lg:text-7xl">
            Kata <span class="text-brand-dark">mereka</span>
          </h2>
        </div>
        <Testimonials client:visible items={testimonials} />
      </section>
    </div>

    <CoachesSection />

    <div class="surface-warm">
      <BlogPreview />
    </div>

    <FaqSection />

    <CtaBand />
  </main>

  <Footer />
  <WaPopup client:load />
  <Dock client:load />
</Base>
