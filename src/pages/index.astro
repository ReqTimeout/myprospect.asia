---
import Base from '../layouts/Base.astro';

const WA = 'https://wa.me/6285924041004?text=Halo%2C%20saya%20tertarik%20dengan%20Sports%20Communication%20Program.%20Boleh%20info%20lebih%20lanjut%3F';
---

<Base title="Prospect Asia — Jadi Atlet Modern | Sports Communication Program">
  <main>
    <section class="relative flex min-h-dvh flex-col items-center justify-center px-6 text-center grain overflow-hidden">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_120%,rgba(200,35,43,0.22),transparent_60%)]"></div>

      <p class="relative z-10 mb-5 inline-block rounded-full border border-gold/40 bg-gold/10 px-4 py-1.5 text-xs font-semibold tracking-widest text-gold uppercase">
        #JadiAtletModern
      </p>

      <h1 class="display relative z-10 text-[13vw] leading-[0.92] sm:text-7xl md:text-8xl">
        Jadi Atlet<br />
        <span class="text-brand">Modern</span> dengan<br />
        Sports Communication
      </h1>

      <p class="relative z-10 mt-6 max-w-md text-sm leading-relaxed text-bone/70 sm:text-base">
        Public speaking &amp; bahasa Inggris khusus atlet — biar suaramu sekuat performamu.
        Online, fleksibel, didampingi coach berpengalaman.
      </p>

      <div class="relative z-10 mt-5 flex flex-wrap items-center justify-center gap-2 text-xs font-semibold">
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">2.175+ Atlet</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">25+ Akademi</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">6 Coach</span>
      </div>

      <a
        href={WA}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="home-hero"
        class="relative z-10 mt-8 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-white uppercase transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none active:scale-95"
      >
        Daftar via WhatsApp
        <span aria-hidden="true">↗</span>
      </a>

      <p class="relative z-10 mt-3 text-xs text-bone/50">Konsultasi gratis — jawab cepat di jam kerja</p>
    </section>
  </main>
</Base>
