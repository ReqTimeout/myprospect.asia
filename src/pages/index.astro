---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Dock from '../components/islands/Dock.svelte';
import WaPopup from '../components/islands/WaPopup.svelte';
import TickerRibbon from '../components/TickerRibbon.astro';
import Chapter from '../components/Chapter.astro';
import PartnersSection from '../components/PartnersSection.astro';
import StatsBar from '../components/StatsBar.astro';
import AboutSection from '../components/AboutSection.astro';
import ProgramSection from '../components/ProgramSection.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import Testimonials from '../components/islands/Testimonials.svelte';
import CoachesSection from '../components/CoachesSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { waLink } from '../lib/wa';
import { cabangOlahraga } from '../data/sports';
import { testimonials } from '../data/testimonials';
import { faqs } from '../data/faq';
import { organizationSchema, faqSchema } from '../lib/seo';

const schema = [organizationSchema, faqSchema(faqs)];
---

<Base
  title="Jadi Atlet Modern | Sports Communication Program Prospect Asia"
  schema={schema}
>
  <Header />

  <main>
    <section class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 pt-14 pb-24 text-center sm:px-6">
      <div class="art-dots absolute inset-0 [mask-image:linear-gradient(to_bottom,transparent,black_55%,transparent)]" aria-hidden="true"></div>
      <div class="pat-halftone absolute -top-28 -left-28 h-96 w-96 opacity-55 pat-fade-tr" style="--pat-gap: 8px" aria-hidden="true"></div>
      <div class="art-pitch absolute inset-x-0 bottom-0 h-[70%] opacity-60 [mask-image:linear-gradient(to_top,black,transparent)]" aria-hidden="true"></div>
      <div class="sport-ball sport-ball--orange -left-6 top-[38%] hidden h-12 w-12 lg:block" aria-hidden="true"></div>
      <div class="sport-ball right-[4%] top-[22%] hidden h-8 w-8 xl:block" aria-hidden="true"></div>
      <div class="pointer-events-none absolute top-24 left-[8%] hidden -rotate-12 rounded-2xl border-3 border-ink/10 bg-white px-4 py-2 shadow-soft sm:block" aria-hidden="true">
        <span class="display text-lg text-ink">SPEAK LOUD!</span>
      </div>
      <div class="pointer-events-none absolute right-[7%] bottom-40 hidden rotate-6 rounded-full border-3 border-brand bg-brand-soft px-5 py-2 sm:block" aria-hidden="true">
        <span class="text-sm font-black text-ink">2.175+ atlet</span>
      </div>
      <div class="pointer-events-none absolute top-1/2 left-[12%] hidden h-4 w-4 rotate-45 rounded-sm bg-crimson sm:block" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-[14%] top-56 hidden h-3 w-3 rounded-full bg-gold sm:block" aria-hidden="true"></div>

      <p data-hero="badge" class="relative z-10 mb-5 inline-block rounded-full bg-brand px-4 py-1.5 text-[11px] font-bold tracking-[0.2em] text-ink uppercase sm:text-xs">
        #JadiAtletModern
      </p>

      <h1 data-hero="title" class="display relative z-10 text-[12vw] leading-[0.92] sm:text-6xl md:text-7xl lg:text-8xl">
        Jadi Atlet<br />
        <span class="text-brand">Modern</span> dengan<br />
        Sports Communication
      </h1>

      <p data-hero="sub" class="relative z-10 mt-5 max-w-md text-sm leading-relaxed text-ink/70 sm:text-base">
        Public speaking &amp; bahasa Inggris khusus atlet, biar suaramu sekuat performamu.
        Online, fleksibel, didampingi coach berpengalaman.
      </p>

      <div class="relative z-10 mt-8 w-full max-w-lg sm:max-w-2xl">
        <img
          src="/media/athletes-cutout.webp"
          alt="Delapan atlet lintas cabang berprestasi membawa piala sebagai wajah atlet modern Prospect Asia"
          width="910"
          height="405"
          fetchpriority="high"
          data-hero="photo"
          class="w-full"
        />
      </div>

      <a
        href={waLink({ source: 'hero' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="hero"
        data-register
        data-source="hero"
        data-magnetic
        data-hero="cta"
        class="btn-pop relative z-10 mt-7 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-ink uppercase hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
      >
        Daftar Sekarang
        <span aria-hidden="true">↗</span>
      </a>
      <p class="relative z-10 mt-3 text-xs text-ink/70">Isi formulir 30 detik · admin balas di jam kerja</p>
      <div class="relative z-10 mt-10 flex flex-col items-center gap-1.5 text-ink/70" aria-hidden="true">
        <span class="text-[10px] font-bold tracking-[0.25em] uppercase">Scroll</span>
        <span class="scroll-hint block h-9 w-5 rounded-full border-2 border-ink/25 pt-1.5">
          <span class="block h-1.5 w-1.5 rounded-full bg-brand"></span>
        </span>
      </div>
    </section>

    <TickerRibbon
      items={cabangOlahraga.map((c) => c.nama)}
      speed={34}
      tone="ink"
    />

    <!-- Scoreboard sekarang versi terang (panel putih + angka oranye), jadi
         tidak lagi butuh wrapper gelap. -->
    <StatsBar />

    <AboutSection />

    <!-- Section "Level & Journey" dihapus atas permintaan klien. -->

    <!-- Section Program jadi terang (bg-paper-deep di dalamnya); blok gelap
         yang tersisa di halaman hanya scoreboard, pita CTA, dan footer. -->
    <ProgramSection />

    <WorkshopSection />

    <div class="surface-warm">
      <section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
        <div class="pat-halftone absolute -bottom-24 -left-24 h-72 w-72 opacity-45 pat-fade-tr" style="--pat-gap: 8px" aria-hidden="true"></div>

        <Chapter num="07" label="Testimoni" class="mb-6" />

        <div class="mb-8">
          <h2 class="display text-5xl sm:text-6xl lg:text-7xl">
            Kata <span class="hl-brand">mereka</span>
          </h2>
        </div>
        <Testimonials client:visible items={testimonials} />
      </section>
    </div>

    <CoachesSection />

    <div class="surface-warm">
      <BlogPreview />
    </div>

    <FaqSection />

    <CtaBand />

    <div class="surface-hair">
      <PartnersSection />
    </div>
  </main>

  <Footer />
  <WaPopup client:load />
  <Dock client:load active="home" />
</Base>
