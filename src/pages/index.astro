---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Dock from '../components/islands/Dock.svelte';
import WaPopup from '../components/islands/WaPopup.svelte';
import Marquee from '../components/Marquee.astro';
import StatsBar from '../components/StatsBar.astro';
import AboutSection from '../components/AboutSection.astro';
import LevelJourney from '../components/islands/LevelJourney.svelte';
import ProgramSection from '../components/ProgramSection.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import Testimonials from '../components/islands/Testimonials.svelte';
import CoachesSection from '../components/CoachesSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { waLink } from '../lib/wa';
import { partners } from '../data/partners';
import { testimonials } from '../data/testimonials';

const partnerNames = partners.map((p) => p.nama);
---

<Base title="Prospect Asia — Jadi Atlet Modern | Sports Communication Program">
  <Header />

  <main>
    <section class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 pt-14 pb-24 text-center grain sm:px-6">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_115%,rgba(200,35,43,0.28),transparent_62%)]" aria-hidden="true"></div>

      <p class="relative z-10 mb-5 inline-block rounded-full border border-gold/40 bg-gold/10 px-4 py-1.5 text-[11px] font-bold tracking-[0.2em] text-gold uppercase sm:text-xs">
        #JadiAtletModern
      </p>

      <h1 class="display relative z-10 text-[12vw] leading-[0.92] sm:text-6xl md:text-7xl lg:text-8xl">
        Jadi Atlet<br />
        <span class="text-brand">Modern</span> dengan<br />
        Sports Communication
      </h1>

      <p class="relative z-10 mt-5 max-w-md text-sm leading-relaxed text-bone/70 sm:text-base">
        Public speaking &amp; bahasa Inggris khusus atlet — biar suaramu sekuat performamu.
        Online, fleksibel, didampingi coach berpengalaman.
      </p>

      <div class="relative z-10 mt-6 w-full max-w-sm sm:max-w-md">
        <div class="grain relative overflow-hidden rounded-3xl border border-white/10 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.9)]">
          <img
            src="/media/hero-athletes.jpg"
            alt="Tujuh atlet lintas cabang membawa piala — wajah atlet modern Prospect Asia"
            width="1080"
            height="1350"
            fetchpriority="high"
            class="aspect-4/5 w-full object-cover object-top sm:aspect-16/10"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent" aria-hidden="true"></div>
        </div>
      </div>

      <a
        href={waLink({ source: 'hero' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="hero"
        class="relative z-10 mt-7 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-white uppercase transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none active:scale-95"
      >
        Daftar via WhatsApp
        <span aria-hidden="true">↗</span>
      </a>
      <p class="relative z-10 mt-3 text-xs text-bone/50">Konsultasi gratis · jawab cepat di jam kerja</p>
    </section>

    <Marquee items={partnerNames} />

    <StatsBar />

    <AboutSection />

    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="mb-8 max-w-2xl">
        <p class="text-xs font-bold tracking-[0.2em] text-gold uppercase">Level & Journey</p>
        <h2 class="display mt-2 text-4xl sm:text-5xl">Dari nol sampai<br />siap panggung</h2>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6 sm:p-8">
        <LevelJourney client:visible />
      </div>
    </section>

    <ProgramSection />

    <WorkshopSection />

    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="mb-8">
        <p class="text-xs font-bold tracking-[0.2em] text-gold uppercase">Kata Mereka</p>
        <h2 class="display mt-2 text-4xl sm:text-5xl">Testimoni atlet</h2>
      </div>
      <Testimonials client:visible items={testimonials} />
    </section>

    <CoachesSection />

    <BlogPreview />

    <FaqSection />

    <CtaBand />
  </main>

  <Footer />
  <WaPopup client:load />
  <Dock client:load />
</Base>
