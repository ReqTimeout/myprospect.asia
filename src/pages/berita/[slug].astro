---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Dock from '../../components/islands/Dock.svelte';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { waLink } from '../../lib/wa';

export async function getStaticPaths() {
  const posts = await getCollection('berita', (p) => p.data.status === 'published');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const related = (await getCollection('berita', (p) => p.data.status === 'published' && p.id !== post.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const fmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.data.title,
  description: post.data.desc,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'id',
  author: { '@type': 'Organization', name: 'Prospect Asia' },
  publisher: { '@type': 'Organization', name: 'Prospect Asia', logo: { '@type': 'ImageObject', url: 'https://myprospect.asia/favicon.png' } },
  mainEntityOfPage: `https://myprospect.asia/berita/${post.id}`,
};
---

<Base title={`${post.data.title} — Prospect Asia`} description={post.data.desc} schema={schema}>
  <Header />

  <main class="pt-14">
    <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <a href="/berita" class="inline-block py-2 text-sm font-bold text-gold transition hover:underline">← Semua berita</a>

      <div class="mt-6 flex items-center gap-3 text-xs">
        <span class="rounded-full border border-gold/40 bg-gold/10 px-3 py-1 font-black tracking-wider text-gold uppercase">
          {post.data.kategori}
        </span>
        <time class="text-bone/50" datetime={post.data.pubDate.toISOString()}>
          {fmt.format(post.data.pubDate)}
        </time>
      </div>

      <h1 class="display mt-4 text-4xl leading-[1.02] sm:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-base leading-relaxed text-bone/70">{post.data.desc}</p>

      {
        post.data.cover && (
          <img
            src={post.data.cover}
            alt=""
            width="1200"
            height="630"
            class="mt-8 aspect-16/9 w-full rounded-3xl border border-white/10 object-cover"
          />
        )
      }

      <div class="prose-custom mt-10">
        <Content />
      </div>

      <div class="mt-10 rounded-3xl border border-gold/30 bg-gold/5 p-6 text-center">
        <p class="text-sm text-bone/75">Mau atletmu tampil seperti ini?</p>
        <a
          href={waLink({ program: post.data.title, source: 'berita-detail' })}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-cta="berita-detail"
          class="mt-3 inline-flex rounded-2xl bg-brand px-6 py-3.5 text-sm font-bold text-white transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none active:scale-95"
        >
          Chat admin via WhatsApp ↗
        </a>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="mx-auto max-w-3xl px-4 pb-12 sm:px-6">
          <h2 class="display mb-5 text-2xl">Baca juga</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {related.map((r) => (
              <a
                href={`/berita/${r.id}`}
                class="rounded-3xl border border-white/10 bg-ink-2 p-5 transition hover:-translate-y-1 hover:border-gold/50 focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none"
              >
                <p class="text-[10px] font-black tracking-wider text-gold uppercase">{r.data.kategori}</p>
                <p class="mt-2 text-sm leading-snug font-bold">{r.data.title}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <CtaBand />
  </main>

  <Footer />
  <Dock client:load />
</Base>
