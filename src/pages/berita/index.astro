---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Dock from '../../components/islands/Dock.svelte';
import Footer from '../../components/Footer.astro';
import BeritaList from '../../components/islands/BeritaList.svelte';
import { waLink } from '../../lib/wa';
import heroBackdrop from '../../assets/generated/a1-hero-wide.jpg';

const posts = (await getCollection('berita', (p) => p.data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const kategori = ['Berita', 'Bintang', 'Kolaborasi'] as const;
---

<Base title="Berita Atlet Modern — Prospect Asia" description="Kabar terbaru seputar atlet, program Sports Communication, dan kolaborasi Prospect Asia.">
  <Header />

  <main class="pt-14">
    <section class="relative overflow-hidden border-b border-white/10">
      <Image
        src={heroBackdrop}
        alt=""
        width={1920}
        height={1080}
        loading="eager"
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover opacity-35"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/88 to-ink/60" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <p class="text-xs font-bold tracking-[0.2em] text-gold uppercase">Blog</p>
        <h1 class="display mt-2 text-5xl sm:text-6xl">Berita Atlet Modern</h1>
        <p class="mt-3 max-w-xl text-sm text-bone/60 sm:text-base">
          Kabar program, sorotan atlet, dan kolaborasi akademi — semuanya dari kacamata Sports Communication.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">

      <div class="mt-8 flex flex-wrap gap-2" role="list">
        {
          kategori.map((k) => (
            <span
              role="listitem"
              class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-bold text-bone/70"
            >
              {k}
            </span>
          ))
        }
      </div>

      <div class="mt-8">
        <BeritaList
          client:visible
          posts={posts.map((p) => ({
            id: p.id,
            title: p.data.title,
            desc: p.data.desc,
            kategori: p.data.kategori,
            pubDate: p.data.pubDate.toISOString(),
          }))}
        />
      </div>

      <p class="mt-12 text-center text-sm text-bone/55">
        Punya cerita atlet hebat?{' '}
        <a
          href={waLink({ program: 'Berita Atlet Modern', source: 'berita-list' })}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-cta="berita-list"
          class="inline-block py-1.5 font-bold text-gold hover:underline"
        >
          Kirim ke kami via WhatsApp ↗
        </a>
      </p>
    </section>
  </main>

  <Footer />
  <Dock client:load />
</Base>
