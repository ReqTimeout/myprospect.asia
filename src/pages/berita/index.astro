---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Dock from '../../components/islands/Dock.svelte';
import Footer from '../../components/Footer.astro';
import { waLink } from '../../lib/wa';
import heroBackdrop from '../../assets/generated/a1-hero-wide.jpg';

const posts = (await getCollection('berita', (p) => p.data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const kategori = ['Berita', 'Bintang', 'Kolaborasi'] as const;
const fmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Berita Atlet Modern — Prospect Asia" description="Kabar terbaru seputar atlet, program Sports Communication, dan kolaborasi Prospect Asia.">
  <Header />

  <main class="pt-14">
    <section class="relative overflow-hidden border-b border-white/10">
      <Image
        src={heroBackdrop}
        alt=""
        width={1920}
        height={1080}
        loading="eager"
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover opacity-35"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/88 to-ink/60" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <p class="text-xs font-bold tracking-[0.2em] text-gold uppercase">Blog</p>
        <h1 class="display mt-2 text-5xl sm:text-6xl">Berita Atlet Modern</h1>
        <p class="mt-3 max-w-xl text-sm text-bone/60 sm:text-base">
          Kabar program, sorotan atlet, dan kolaborasi akademi — semuanya dari kacamata Sports Communication.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">

      <div class="mt-8 flex flex-wrap gap-2" role="list">
        {
          kategori.map((k) => (
            <span
              role="listitem"
              class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-bold text-bone/70"
            >
              {k}
            </span>
          ))
        }
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <a
              href={`/berita/${post.id}`}
              class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-ink-2 transition duration-200 hover:-translate-y-1 hover:border-gold/50 focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none"
            >
              <div class="relative aspect-16/10 overflow-hidden bg-gradient-to-br from-brand/40 via-ink-2 to-gold/25">
                {post.data.cover && (
                  <img
                    src={post.data.cover}
                    alt=""
                    loading="lazy"
                    width="640"
                    height="400"
                    class="h-full w-full object-cover"
                  />
                )}
                <span class="absolute top-3 left-3 rounded-full bg-ink/85 px-2.5 py-1 text-[10px] font-black tracking-wider text-gold uppercase backdrop-blur">
                  {post.data.kategori}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-[11px] text-bone/45">{fmt.format(post.data.pubDate)}</p>
                <h2 class="mt-1.5 text-base leading-snug font-bold transition group-hover:text-gold">{post.data.title}</h2>
                <p class="mt-2 line-clamp-2 text-[13px] text-bone/60">{post.data.desc}</p>
              </div>
            </a>
          ))
        }
      </div>

      <p class="mt-12 text-center text-sm text-bone/55">
        Punya cerita atlet hebat?{' '}
        <a
          href={waLink({ program: 'Berita Atlet Modern', source: 'berita-list' })}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-cta="berita-list"
          class="inline-block py-1.5 font-bold text-gold hover:underline"
        >
          Kirim ke kami via WhatsApp ↗
        </a>
      </p>
    </section>
  </main>

  <Footer />
  <Dock client:load />
</Base>
