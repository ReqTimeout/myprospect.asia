---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Dock from '../../components/islands/Dock.svelte';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import { programs, formatIdr, type Program } from '../../data/programs';
import { testimonials } from '../../data/testimonials';
import { faqs } from '../../data/faq';
import { waLink } from '../../lib/wa';
import { courseSchema } from '../../lib/seo';

export function getStaticPaths() {
  return programs.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Program };
const idx = programs.findIndex((x) => x.slug === p.slug);
const testi = testimonials[idx % testimonials.length];
const miniFaq = faqs.filter((f) => f.grup === 'Program').slice(0, 3);
const chips = [p.online ? 'Online' : 'Offline', p.satuan.replace(/^\//, '').trim(), 'Tes penempatan'];
const ctaWa = waLink({ program: p.nama, source: `detail-${p.slug}` });
const heroFotos: Record<string, string> = {
  'elite-1on1': '/media/session-elite.jpg',
  'premium-1on1': '/media/session-premium.jpg',
  'small-group': '/media/session-smallgroup.jpg',
};
const heroFoto = heroFotos[p.slug] ?? '/media/hero-athletes.jpg';
const schema = courseSchema({
  name: p.nama,
  description: p.ringkasan,
  url: `https://myprospect.asia/program/${p.slug}`,
  price: p.harga,
});
---

<Base title={`${p.nama} — Prospect Asia`} description={p.ringkasan} schema={schema}>
  <Header />

  <main class="pt-14">
    <section class="relative overflow-hidden border-b border-ink/10">
      <img
        src={heroFoto}
        alt="Sesi Sports Communication Prospect Asia"
        width="1400"
        height="788"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[50%_25%] opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/92 to-paper/70" aria-hidden="true"></div>
      <div class="art-ring right-10 top-24 hidden h-14 w-14 border-crimson/20 sm:block" aria-hidden="true"></div>
      <div class="art-pitch absolute inset-0 opacity-40 [mask-image:linear-gradient(to_bottom,black,transparent_65%)]" aria-hidden="true"></div>
      <div class="art-diamond right-24 top-40 h-2.5 w-2.5 bg-crimson/50 hidden sm:block" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <a href="/#program" class="inline-block py-2 text-sm font-bold text-brand-dark transition hover:underline">← Semua program</a>

        {
          p.badge && (
            <p
              class:list={[
                'mt-6 inline-block rounded-full px-3 py-1 text-[11px] font-black tracking-widest uppercase',
                p.badgeTone === 'gold' ? 'bg-gold text-ink' : 'bg-brand text-ink',
              ]}
            >
              {p.badge}
            </p>
          )
        }

        <h1 class="display mt-4 text-5xl leading-[0.95] sm:text-7xl">{p.nama}</h1>
        <p class="mt-3 text-base text-ink/70 sm:text-lg">{p.sub}</p>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            chips.map((c) => (
              <span class="rounded-full border border-ink/20 bg-white px-3.5 py-1.5 text-xs font-semibold text-ink/75">
                {c}
              </span>
            ))
          }
        </div>

        <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            {p.hargaCoret ? <p class="text-sm text-ink/45 line-through">Rp{formatIdr(p.hargaCoret)}</p> : null}
            {
              p.harga > 0 ? (
                <p class="display text-5xl text-brand">Rp{formatIdr(p.harga)}</p>
              ) : (
                <p class="display text-4xl text-brand-dark">Info via WhatsApp</p>
              )
            }
            <p class="mt-1 text-xs text-ink/55">{p.satuan}</p>
          </div>
          <a
            href={ctaWa}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-cta={`detail-${p.slug}`}
            class="inline-flex items-center justify-center rounded-2xl bg-brand px-7 py-4 text-sm font-bold text-ink transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
          >
            Daftar via WhatsApp ↗
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Apa yang akan dikuasai</p>
      <h2 class="display mt-2 text-3xl sm:text-4xl">Komunikasi level atlet pro</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          p.dikuasai.map((d) => (
            <li class="flex items-start gap-3 rounded-2xl border border-ink/10 bg-white px-4 py-3.5 text-sm text-ink/85">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold text-[11px] font-black text-ink" aria-hidden="true">
                ✓
              </span>
              {d}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-y border-ink/10 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Yang didapatkan</p>
        <h2 class="display mt-2 text-3xl sm:text-4xl">Benefit lengkap</h2>
        <ul class="mt-6 space-y-3">
          {
            p.didapat.map((d) => {
              const gold = /nasional/i.test(d);
              return (
                <li
                  class:list={[
                    'flex items-start gap-3 rounded-2xl px-4 py-3.5 text-sm',
                    gold ? 'border border-gold/40 bg-gold/10 text-brand-dark' : 'border border-ink/10 bg-white text-ink/85',
                  ]}
                >
                  <span aria-hidden="true">{gold ? '★' : '✓'}</span>
                  {d}
                  {gold && <span class="ml-auto rounded-full bg-gold px-2 py-0.5 text-[10px] font-black text-ink">BONUS</span>}
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Peningkatan bulanan</p>
      <h2 class="display mt-2 text-3xl sm:text-4xl">4 bulan, 4 lompatan</h2>
      <ol class="relative mt-8 space-y-6 border-l-2 border-gold/40 pl-6">
        {
          p.journey.map((j) => (
            <li class="relative">
              <span class="absolute -left-[31px] top-1 h-4 w-4 rounded-full border-2 border-gold bg-paper" aria-hidden="true" />
              <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">{j.bulan}</p>
              <p class="mt-1 text-base font-semibold text-ink">{j.teks}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mx-auto max-w-4xl px-4 pb-14 sm:px-6">
      <figure class="rounded-3xl border border-ink/10 bg-gradient-to-br from-brand/15 to-transparent p-7">
        <blockquote class="text-lg leading-relaxed text-ink/90 italic sm:text-xl">“{testi.kutipan}”</blockquote>
        <figcaption class="mt-4 text-sm text-ink/60">
          <span class="font-bold text-ink">{testi.nama}</span> · {testi.asal} · {testi.olahraga}
        </figcaption>
      </figure>
    </section>

    <section class="border-t border-ink/10 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">FAQ mini</p>
        <h2 class="display mt-2 text-3xl sm:text-4xl">Yang sering ditanya</h2>
        <div class="mt-6 space-y-3">
          {
            miniFaq.map((f, i) => (
              <details class="group rounded-2xl border border-ink/10 bg-paper-deep open:border-gold/40" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-bold sm:text-base focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none">
                  {f.q}
                  <span class="text-brand-dark transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="px-5 pb-5 text-sm leading-relaxed text-ink/70">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="daftar" class="mx-auto max-w-4xl scroll-mt-20 px-4 py-14 sm:px-6">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Mulai sekarang</p>
          <h2 class="display mt-2 text-3xl sm:text-4xl">Isi data,<br />admin lanjut di WA</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink/65">
            Setelah formulir dikirim, WhatsApp langsung terbuka dengan pesan yang sudah terisi — admin tinggal
            membalas untuk jadwal, tes penempatan, dan cara bayar.
          </p>
          <a
            href={ctaWa}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-cta={`detail-bawah-${p.slug}`}
            class="mt-6 inline-flex rounded-2xl border border-gold px-6 py-3.5 text-sm font-bold text-brand-dark transition hover:bg-gold hover:text-ink focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
          >
            Chat langsung tanpa form ↗
          </a>
        </div>
        <LeadForm program={p.nama} sumber={`detail-${p.slug}`} variant="atlet" />
      </div>
    </section>
  </main>

  <Footer />
  <Dock client:load active="program" />
</Base>
