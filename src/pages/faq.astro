---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Dock from '../components/islands/Dock.svelte';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqGroups from '../components/islands/FaqGroups.svelte';
import { faqs } from '../data/faq';
import { faqSchema } from '../lib/seo';

const schema = faqSchema(faqs);
---

<Base title="FAQ — Prospect Asia" description="Pertanyaan seputar program Sports Communication, workshop akademi, dan pendaftaran via WhatsApp." schema={schema}>
  <Header />

  <main class="pt-14">
    <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <p class="text-xs font-bold tracking-[0.2em] text-brand-dark uppercase">FAQ</p>
      <h1 class="display mt-2 text-5xl sm:text-6xl">Pertanyaan<br />umum</h1>

      <div class="mt-10">
        <FaqGroups client:visible items={faqs} />
      </div>
    </section>

    <CtaBand />
  </main>

  <Footer />
  <Dock client:load />
</Base>
