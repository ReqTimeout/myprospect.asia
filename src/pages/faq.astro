---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Dock from '../components/islands/Dock.svelte';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/faq';

const grup = ['Umum', 'Program', 'Workshop', 'Pembayaran'] as const;
---

<Base title="FAQ — Prospect Asia" description="Pertanyaan seputar program Sports Communication, workshop akademi, dan pendaftaran via WhatsApp.">
  <Header />

  <main class="pt-14">
    <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <p class="text-xs font-bold tracking-[0.2em] text-gold uppercase">FAQ</p>
      <h1 class="display mt-2 text-5xl sm:text-6xl">Pertanyaan<br />umum</h1>

      <div class="mt-10 space-y-10">
        {
          grup.map((g) => {
            const items = faqs.filter((f) => f.grup === g);
            if (items.length === 0) return null;
            return (
              <section>
                <h2 class="display mb-4 text-2xl text-gold">{g}</h2>
                <div class="space-y-3">
                  {items.map((f, i) => (
                    <details class="group rounded-2xl border border-white/10 bg-white/5 open:border-gold/40" open={i === 0 && g === 'Umum'}>
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-bold transition hover:text-gold focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none sm:text-base">
                        {f.q}
                        <span class="shrink-0 text-gold transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                          +
                        </span>
                      </summary>
                      <p class="px-5 pb-5 text-sm leading-relaxed text-bone/70">{f.a}</p>
                    </details>
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>
    </section>

    <CtaBand />
  </main>

  <Footer />
  <Dock client:load />
</Base>
