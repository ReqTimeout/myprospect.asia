---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Dock from '../../components/islands/Dock.svelte';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import { workshops, formatIdr, type Workshop } from '../../data/workshops';
import { faqs } from '../../data/faq';
import { waLink } from '../../lib/wa';
import { courseSchema } from '../../lib/seo';

export function getStaticPaths() {
  return workshops.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props as { w: Workshop };
const miniFaq = faqs.filter((f) => f.grup === 'Workshop').slice(0, 3);
const ctaWa = waLink({ program: w.nama, source: `workshop-detail-${w.slug}` });
const durasiKecil = w.durasi.split('·')[1]?.trim() ?? w.durasi;
const heroFoto: Record<string, string> = {
  starter: '/media/workshop-crowd.jpg',
  premium: '/media/interview-zone.jpg',
};
const hero = heroFoto[w.slug] ?? '/media/workshop-hero.jpg';
const docs = Array.from({ length: 8 }, (_, i) => `/media/docs-${i + 1}.jpg`);
const schema = courseSchema({
  name: w.nama,
  description: w.ringkasan,
  url: `https://myprospect.asia/workshop/${w.slug}`,
  price: w.harga,
  duration: w.durasi,
});
---

<Base title={`${w.nama} — Workshop untuk Akademi`} description={w.ringkasan} schema={schema}>
  <Header />

  <main class="pt-14">
    <section class="relative overflow-hidden border-b border-ink/10">
      <img
        src={hero}
        alt="Suasana workshop Sports Communication bersama akademi olahraga"
        width="1600"
        height="900"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/92 to-paper/70" aria-hidden="true"></div>
      <div class="art-ring right-10 top-24 hidden h-14 w-14 border-crimson/20 sm:block" aria-hidden="true"></div>
      <div class="art-track absolute inset-x-0 bottom-0 h-48 opacity-50" aria-hidden="true"></div>
      <div class="art-diamond right-24 top-40 h-2.5 w-2.5 bg-crimson/50 hidden sm:block" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <a href="/#workshop" class="inline-block py-2 text-sm font-bold text-brand-dark transition hover:underline">← Semua workshop</a>

        <p class="mt-6 inline-block rounded-full bg-gold px-3 py-1 text-[11px] font-black tracking-widest text-ink uppercase">
          B2B · Akademi &amp; Klub
        </p>

        <h1 class="display mt-4 text-5xl leading-[0.95] sm:text-7xl">{w.nama}</h1>
        <p class="mt-3 max-w-2xl text-base text-ink/70 sm:text-lg">{w.ringkasan}</p>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            [w.durasi, w.target, 'Didampingi coach'].map((c) => (
              <span class="rounded-full border border-ink/20 bg-white px-3.5 py-1.5 text-xs font-semibold text-ink/75">
                {c}
              </span>
            ))
          }
        </div>

        <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            {
              w.harga > 0 ? (
                <>
                  <p class="display text-5xl text-brand">Rp{formatIdr(w.harga)}</p>
                  <p class="mt-1 text-xs text-ink/55">/ sesi · {durasiKecil}</p>
                  {w.catatan && <p class="mt-1.5 text-xs font-black text-brand-dark">{w.catatan}</p>}
                </>
              ) : (
                <>
                  <p class="display text-4xl text-brand-dark">Harga custom</p>
                  <p class="mt-1 text-xs text-ink/55">disusun sesuai kebutuhan akademi</p>
                </>
              )
            }
          </div>
          <a
            href={ctaWa}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-cta={`workshop-detail-${w.slug}`}
            class="inline-flex items-center justify-center rounded-2xl bg-brand px-7 py-4 text-sm font-bold text-ink transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
          >
            Booking untuk akademi ↗
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Yang didapatkan akademi</p>
      <h2 class="display mt-2 text-3xl sm:text-4xl">Run-down manfaat</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          w.didapat.map((d, i) => (
            <li class="flex items-start gap-3 rounded-2xl border border-ink/10 bg-white px-4 py-3.5 text-sm text-ink/85">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold text-[11px] font-black text-ink" aria-hidden="true">
                {i + 1}
              </span>
              {d}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Dokumentasi</p>
      <h2 class="display mt-2 text-3xl sm:text-4xl">Suasana di lapangan</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          docs.map((d) => (
            <div class="grain relative overflow-hidden rounded-2xl border border-ink/10 aspect-4/3">
              <img
                src={d}
                alt="Dokumentasi workshop Prospect Asia"
                loading="lazy"
                width="1000"
                height="667"
                class="h-full w-full object-cover transition duration-500 hover:scale-105"
              />
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-y border-ink/10 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">FAQ mini</p>
        <h2 class="display mt-2 text-3xl sm:text-4xl">Yang ditanya panitia</h2>
        <div class="mt-6 space-y-3">
          {
            miniFaq.map((f, i) => (
              <details class="group rounded-2xl border border-ink/10 bg-paper-deep open:border-gold/40" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-bold sm:text-base focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none">
                  {f.q}
                  <span class="text-brand-dark transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="px-5 pb-5 text-sm leading-relaxed text-ink/70">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="booking" class="mx-auto max-w-4xl scroll-mt-20 px-4 py-14 sm:px-6">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Booking workshop</p>
          <h2 class="display mt-2 text-3xl sm:text-4xl">Booking workshop<br />untuk akademi</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink/65">
            Isi data singkat, WhatsApp langsung terbuka dengan pesan siap kirim — kami bantu susun jadwal,
            jumlah peserta, dan paket yang cocok untuk akademimu.
          </p>
          <a
            href={ctaWa}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-cta={`workshop-bawah-${w.slug}`}
            class="mt-6 inline-flex rounded-2xl border border-gold px-6 py-3.5 text-sm font-bold text-brand-dark transition hover:bg-gold hover:text-ink focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
          >
            Diskusi langsung via WA ↗
          </a>
        </div>
        <LeadForm program={w.nama} sumber={`workshop-detail-${w.slug}`} variant="akademi" />
      </div>
    </section>
  </main>

  <Footer />
  <Dock client:load active="workshop" />
</Base>
