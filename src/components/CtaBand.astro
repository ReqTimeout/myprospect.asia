---
import { waLink } from '../lib/wa';
import SportArt from './SportArt.astro';
import TickerRibbon from './TickerRibbon.astro';

const ticker = [
  'Gratis konsultasi',
  'Jawab cepat di jam kerja',
  'Online · jadwal fleksibel',
  '1-on-1 & small group',
  'Workshop akademi & klub',
  'Bisa mulai minggu ini',
];
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand via-brand to-brand-dark">
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/media/workshop-crowd.jpg" alt="" loading="lazy" class="ken-burns h-full w-full object-cover opacity-70" />
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-br from-brand/88 via-brand/70 to-brand-dark/92"
    aria-hidden="true"
  >
  </div>
  <SportArt variant="stadium" stroke="#ffffff" opacity={0.24} class="absolute inset-0 h-full w-full" />
  <div
    class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.35)_1.4px,transparent_1.4px)] bg-[length:20px_20px] opacity-40 [mask-image:linear-gradient(to_bottom,black,transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="art-blob -top-24 -left-16 h-72 w-72"
    style="background: radial-gradient(circle, rgba(255,195,46,0.75), transparent 70%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="art-blob -right-20 -bottom-28 h-80 w-80"
    style="background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%); animation-delay: -6s;"
    aria-hidden="true"
  >
  </div>
  <div class="art-blob left-1/4 top-1/2 h-56 w-56" style="background: radial-gradient(circle, rgba(200,35,43,0.55), transparent 70%); animation-delay: -3s;" aria-hidden="true"></div>
  <div class="sport-ball left-6 top-16 hidden h-14 w-14 -rotate-12 opacity-95 lg:block" aria-hidden="true"></div>
  <div class="sport-ball right-[6%] bottom-16 hidden h-12 w-12 rotate-12 opacity-90 lg:block" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-8 right-10 hidden rotate-12 rounded-2xl border-4 border-white/25 p-5 sm:block" aria-hidden="true">
    <span class="display block text-3xl text-white/60">#MODERN</span>
  </div>
  <div class="pointer-events-none absolute bottom-10 left-8 hidden -rotate-6 rounded-2xl border-4 border-ink/15 p-4 lg:block" aria-hidden="true">
    <span class="display block text-2xl text-ink/40">BICARA ?!</span>
  </div>

  <div class="relative">
    <TickerRibbon items={ticker} speed={34} tone="ink" class="border-y border-white/20" />

    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <p data-reveal="fade" class="inline-block rounded-full border border-white/40 px-4 py-1.5 text-xs font-bold tracking-[0.25em] text-white uppercase">#JadiAtletModern</p>
      <h2 data-reveal class="display mt-4 text-5xl leading-[0.92] text-white sm:text-7xl lg:text-8xl">
        Berani<br />
        <span class="text-ink [text-shadow:_2px_2px_0_rgba(255,255,255,0.6)]">Bicara?</span>
      </h2>
      <p data-reveal class="mx-auto mt-5 max-w-md text-sm leading-relaxed font-medium text-white/85 sm:text-base">
        Mulai dari chat singkat. Ceritakan atlet &amp; akademimu — kami bantu susun programnya.
      </p>
      <a
        href={waLink({ source: 'cta-band' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="cta-band"
        data-magnetic
        data-reveal="pop"
        class="btn-pop mt-8 inline-flex items-center gap-2 rounded-2xl bg-white px-8 py-4 text-sm font-bold tracking-wide text-ink uppercase shadow-[0_16px_36px_-12px_rgba(0,0,0,0.35)] hover:bg-gold focus-visible:ring-2 focus-visible:ring-ink focus-visible:outline-none"
      >
        Mulai via WhatsApp ↗
      </a>
      <p class="mt-3 text-xs font-medium text-white/70">Gratis konsultasi · jawab cepat di jam kerja</p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <span class="rounded-full border border-white/35 bg-white/15 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase backdrop-blur-sm">
          Online
        </span>
        <span class="rounded-full border border-white/35 bg-white/15 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase backdrop-blur-sm">
          Jadwal fleksibel
        </span>
        <span class="rounded-full border border-white/35 bg-white/15 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase backdrop-blur-sm">
          1-on-1 &amp; Small Group
        </span>
        <span class="rounded-full border border-white/35 bg-white/15 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase backdrop-blur-sm">
          Workshop akademi
        </span>
      </div>
    </div>
  </div>
</section>
