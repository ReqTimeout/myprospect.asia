---
import { waLink } from '../lib/wa';

const chips = ['Online', 'Jadwal fleksibel', '1-on-1 & Small Group', 'Workshop akademi'];
---

<!--
  Pita CTA.

  Revisi 4 Nov 2026: versi lama (foto full-bleed + kartu hitam di atasnya +
  pita ticker gelap) dianggap "jelek banget" — dua blok gelap bertumpuk, dan
  ticker-nya dobel dengan ticker cabang olahraga di bawah hero (§32.2).

  Sekarang: bidang terang, teks tinta, tombol oranye, foto di dalam bingkai
  bulat (tanpa scrim), dan **satu** detail art saja. Pita ticker di sini
  dihapus — bukan karena fitur, tapi karena isinya dobel dengan ticker di bawah hero.
-->
<section class="relative overflow-hidden bg-paper-deep">
  <!-- Satu-satunya art: garis lapangan tipis di tepi bawah. -->
  <div
    class="art-pitch absolute inset-x-0 bottom-0 h-1/2 opacity-40 [mask-image:linear-gradient(to_top,black,transparent_75%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <div>
        <p data-reveal="fade" class="inline-block rounded-full bg-brand px-4 py-1.5 text-[11px] font-bold tracking-[0.2em] text-ink uppercase">
          #JadiAtletModern
        </p>
        <h2 data-reveal class="display mt-4 text-5xl leading-[0.92] text-ink sm:text-6xl lg:text-7xl">
          Berani<br />
          <span class="text-brand">Bicara?</span>
        </h2>
        <p data-reveal class="mt-4 max-w-md text-sm leading-relaxed text-ink/70 sm:text-base">
          Ceritakan dulu atlet atau akademimu, nanti kami bantu arahkan ke program yang pas.
        </p>
        <a
          href={waLink({ source: 'cta-band' })}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-cta="cta-band"
          data-register
          data-source="cta-band"
          data-magnetic
          data-reveal="pop"
          class="btn-pop mt-7 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-ink uppercase hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
        >
          Isi Formulir Pendaftaran ↗
        </a>
        <p class="mt-3 text-xs text-ink/70">Isi formulir 30 detik · admin balas di jam kerja</p>

        <div class="mt-8 flex flex-wrap items-center gap-2">
          {
            chips.map((c) => (
              <span class="rounded-full border border-ink/15 bg-white px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-ink/70 uppercase">
                {c}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Foto di bingkai bulat: penuh warna, tanpa scrim, tanpa kartu gelap. -->
      <div class="relative overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft">
        <img
          src="/media/workshop-crowd.jpg"
          alt="Suasana workshop Sports Communication Prospect Asia bersama atlet akademi mitra"
          loading="lazy"
          class="ken-burns aspect-4/3 w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
