---
import { waLink } from '../lib/wa';
---

<section class="relative overflow-hidden border-y border-white/10 bg-gradient-to-br from-brand/25 via-ink-2 to-ink grain">
  <div
    class="pointer-events-none absolute inset-0 opacity-30"
    style="background-image: repeating-linear-gradient(115deg, transparent 0 22px, rgba(230,168,23,0.16) 22px 23px);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20">
    <p class="text-xs font-bold tracking-[0.25em] text-gold uppercase">#JadiAtletModern</p>
    <h2 class="display mt-4 text-5xl leading-[0.92] sm:text-7xl">
      Berani<br />
      <span class="text-brand">Bicara?</span>
    </h2>
    <p class="mx-auto mt-5 max-w-md text-sm leading-relaxed text-bone/70 sm:text-base">
      Mulai dari chat singkat. Ceritakan atlet &amp; akademimu — kami bantu susun programnya.
    </p>
    <a
      href={waLink({ source: 'cta-band' })}
      target="_blank"
      rel="noopener noreferrer"
      data-wa-cta="cta-band"
      class="mt-8 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-white uppercase transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none active:scale-95"
    >
      Mulai via WhatsApp ↗
    </a>
    <p class="mt-3 text-xs text-bone/50">Gratis konsultasi · jawab cepat di jam kerja</p>
  </div>
</section>
