---
import { waLink } from '../lib/wa';
import SportArt from './SportArt.astro';
import TickerRibbon from './TickerRibbon.astro';

const ticker = [
  'Gratis konsultasi',
  'Jawab cepat di jam kerja',
  'Online · jadwal fleksibel',
  '1-on-1 & small group',
  'Workshop akademi & klub',
  'Bisa mulai minggu ini',
];
---

<!-- Pita CTA: hitam pekat sebagai bidang, oranye penuh pada tombol dan satu
     kata aksen. Chip cukup garis putih tanpa isi translusen. -->
<section class="relative overflow-hidden bg-ink">
  <!-- Permintaan klien: foto tanpa overlay gelap. Foto tampil penuh; teks putih
       duduk di atas bidang hitam pekat (bukan scrim translusen di atas foto). -->
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/media/workshop-crowd.jpg" alt="" loading="lazy" class="h-full w-full object-cover" />
  </div>
  <SportArt variant="stadium" stroke="#ffffff" opacity={0.2} class="absolute inset-0 h-full w-full" />
  <div class="pat-grid-light absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div
    class="pat-halftone absolute inset-0 opacity-55 pat-fade-tr"
    style="--pat-gap: 8px"
    aria-hidden="true"
  >
  </div>
  <div class="sport-ball left-6 top-16 hidden h-14 w-14 -rotate-12 lg:block" aria-hidden="true"></div>
  <div class="sport-ball right-[6%] bottom-16 hidden h-12 w-12 rotate-12 lg:block" aria-hidden="true"></div>

  <div class="relative">
    <TickerRibbon items={ticker} speed={34} tone="ink" class="border-y border-white/20" />

    <div class="relative mx-auto my-4 max-w-4xl rounded-3xl bg-ink px-6 py-16 text-center sm:my-6 sm:px-10 sm:py-24">
      <p data-reveal="fade" class="inline-block rounded-full border border-white/40 px-4 py-1.5 text-xs font-bold tracking-[0.25em] text-white uppercase">#JadiAtletModern</p>
      <h2 data-reveal class="display mt-4 text-5xl leading-[0.92] text-white sm:text-7xl lg:text-8xl">
        Berani<br />
        <span class="text-brand">Bicara?</span>
      </h2>
      <p data-reveal class="mx-auto mt-5 max-w-md text-sm leading-relaxed font-medium text-white/85 sm:text-base">
        Mulai dari chat singkat. Ceritakan atlet &amp; akademimu, kami bantu susun programnya.
      </p>
      <a
        href={waLink({ source: 'cta-band' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="cta-band"
        data-register
        data-source="cta-band"
        data-magnetic
        data-reveal="pop"
        class="btn-pop mt-8 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold tracking-wide text-ink uppercase hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
      >
        Isi Formulir Pendaftaran ↗
      </a>
      <p class="mt-3 text-xs font-medium text-white/70">Isi formulir 30 detik · admin balas di jam kerja</p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <span class="rounded-full border border-white/40 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase">
          Online
        </span>
        <span class="rounded-full border border-white/40 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase">
          Jadwal fleksibel
        </span>
        <span class="rounded-full border border-white/40 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase">
          1-on-1 &amp; Small Group
        </span>
        <span class="rounded-full border border-white/40 px-3.5 py-1.5 text-[11px] font-bold tracking-wide text-white uppercase">
          Workshop akademi
        </span>
      </div>
    </div>
  </div>
</section>
