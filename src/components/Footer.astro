---
import { SITE } from '../data/site';
import { WA_ICON } from '../lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="relative border-t border-ink/10 bg-paper-deep/70 pb-28 lg:pb-10">
  <div
    class="absolute inset-x-0 top-0 h-1"
    style="background: linear-gradient(90deg, var(--color-brand), var(--color-gold));"
    aria-hidden="true"
  ></div>
  <div
    class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-8 px-4 py-12 sm:px-6 md:grid-cols-3 md:gap-10"
  >
    <div class="col-span-2 md:col-span-1">
      <p class="display skew-mark text-2xl">Prospect</p>
      <p class="mt-2 text-sm leading-relaxed text-ink/70">
        {SITE.legal} — Sports Communication program untuk atlet modern.
      </p>
      <p class="mt-3 text-xs text-ink/70">{SITE.hashtag}</p>
    </div>

    <nav aria-label="Navigasi footer">
      <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Jelajahi</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/#program" class="inline-block py-1.5 text-ink/65 transition hover:text-ink">Program</a></li>
        <li><a href="/#workshop" class="inline-block py-1.5 text-ink/65 transition hover:text-ink">Workshop</a></li>
        <li><a href="/berita" class="inline-block py-1.5 text-ink/65 transition hover:text-ink">Berita</a></li>
        <li><a href="/tentang" class="inline-block py-1.5 text-ink/65 transition hover:text-ink">Tentang</a></li>
        <li><a href="/faq" class="inline-block py-1.5 text-ink/65 transition hover:text-ink">FAQ</a></li>
      </ul>
    </nav>

    <div>
      <p class="eyebrow text-xs font-black tracking-widest text-brand-dark uppercase">Kontak</p>
      <p class="mt-3 text-sm text-ink/65">WhatsApp Admin</p>
      <a
        href={`https://wa.me/${SITE.waNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="footer"
        class="mt-1 flex items-center gap-2 py-1 text-ink transition hover:text-wa-ink"
      >
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-wa text-ink shadow-[0_6px_14px_-6px_rgba(37,211,102,0.9)]" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" set:html={WA_ICON} />
        </span>
        <span class="display text-xl sm:text-2xl">{SITE.waDisplay}</span>
      </a>
      <p class="mt-3 text-xs text-ink/70">Bandung · Indonesia</p>
    </div>
  </div>

  <div class="border-t border-ink/8">
    <p class="mx-auto max-w-6xl px-4 py-5 text-center text-[11px] text-ink/65 sm:px-6">
      © {year} {SITE.legal}. All rights reserved.
    </p>
  </div>
</footer>
