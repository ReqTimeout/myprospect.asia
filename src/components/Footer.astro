---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-2/60 pb-28 lg:pb-10">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="display skew-mark text-2xl">Prospect</p>
      <p class="mt-2 text-sm leading-relaxed text-bone/60">
        {SITE.legal} — Sports Communication program untuk atlet modern.
      </p>
      <p class="mt-3 text-xs text-bone/45">{SITE.hashtag}</p>
    </div>

    <nav aria-label="Navigasi footer">
      <p class="text-xs font-black tracking-widest text-gold uppercase">Jelajahi</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/#program" class="inline-block py-1.5 text-bone/65 transition hover:text-bone">Program</a></li>
        <li><a href="/#workshop" class="inline-block py-1.5 text-bone/65 transition hover:text-bone">Workshop</a></li>
        <li><a href="/berita" class="inline-block py-1.5 text-bone/65 transition hover:text-bone">Berita</a></li>
        <li><a href="/tentang" class="inline-block py-1.5 text-bone/65 transition hover:text-bone">Tentang</a></li>
        <li><a href="/faq" class="inline-block py-1.5 text-bone/65 transition hover:text-bone">FAQ</a></li>
      </ul>
    </nav>

    <div>
      <p class="text-xs font-black tracking-widest text-gold uppercase">Kontak</p>
      <p class="mt-3 text-sm text-bone/65">WhatsApp Admin</p>
      <a
        href={`https://wa.me/${SITE.waNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="footer"
        class="display mt-1 block py-1 text-2xl text-bone transition hover:text-gold"
      >
        {SITE.waDisplay}
      </a>
      <p class="mt-3 text-xs text-bone/45">Bandung · Indonesia</p>
    </div>
  </div>

  <div class="border-t border-white/8">
    <p class="mx-auto max-w-6xl px-4 py-5 text-center text-[11px] text-bone/40 sm:px-6">
      © {year} {SITE.legal}. All rights reserved.
    </p>
  </div>
</footer>
