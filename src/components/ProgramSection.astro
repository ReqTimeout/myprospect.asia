---
import { waLink } from '../lib/wa';
import { programs, formatIdr } from '../data/programs';
import SectionImage from './SectionImage.astro';
import Chapter from './Chapter.astro';

const programPhoto: Record<string, string> = {
  'elite-1on1': '/media/session-elite.jpg',
  'premium-1on1': '/media/session-premium.jpg',
  'small-group': '/media/session-smallgroup.jpg',
};

const membershipBenefits = [
  'Sesi rutin tanpa ribet booking ulang',
  'Materi & e-library eksklusif atlet',
  'Priority support dari coach',
  'Community atlet lintas cabang',
];

const hemat = (coret: number | undefined, harga: number) =>
  coret && coret > harga ? Math.round(((coret - harga) / coret) * 100) : 0;
---

<section id="program" class="relative w-full overflow-hidden scroll-mt-20 bg-paper-deep py-14">
  <SectionImage src="/media/sections/program.webp" pos="tl" opacity={0.13} />
  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <Chapter num="05" label="Program Unggulan" tone="light" class="mb-6" />
      <h2 class="display text-5xl leading-[0.9] sm:text-6xl lg:text-7xl text-ink">
        Private 1-on-1<br />
        <span class="text-brand">&amp; Small Group</span>
      </h2>
    </div>
    <p class="max-w-xs text-sm leading-relaxed text-ink">
      Semua online, jadwal fleksibel, didampingi coach. Mulai dari tes penempatan dulu.
    </p>
  </div>

  <div class="grid gap-5 md:grid-cols-3" data-reveal-group>
    {
      programs.map((p, i) => (
        <article
          data-reveal="pop"

          class="spot prog-card group relative flex flex-col overflow-hidden rounded-3xl"
        >
          <div
            class="ticket relative aspect-21/9 overflow-hidden bg-paper-deep"
            style="--notch-y: 100%; --notch-bg: var(--color-paper-deep);"
          >
            <img
              src={programPhoto[p.slug]}
              alt={`Atlet mengikuti sesi ${p.nama} bersama coach Prospect Asia`}
              loading="lazy"
              width="1376"
              height="768"
              class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            {p.badge && (
              <p
                class:list={[
                  'absolute top-3 left-3 rounded-full px-3 py-1 text-[10px] font-black tracking-widest uppercase shadow-sm',
                  p.badgeTone === 'gold' ? 'bg-ink text-brand' : 'bg-brand text-white',
                ]}
              >
                {p.badge}
              </p>
            )}
            {p.online && (
              <span class="live-badge absolute top-3 right-3">
                <span class="live-dot" aria-hidden="true"></span>
                Online
              </span>
            )}
            <p class="absolute bottom-3 left-4 max-w-[calc(100%-2rem)] rounded-2xl bg-ink/80 px-3 py-1.5 text-[11px] font-bold tracking-[0.16em] text-white uppercase">
              {p.sub}
            </p>
          </div>

          <div class="relative z-10 flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="display text-2xl text-ink">{p.nama}</h3>
              <span class="display shrink-0 text-4xl leading-none text-brand" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="mt-4">
              {p.hargaCoret ? (
                <p class="text-sm text-ink line-through">Rp{formatIdr(p.hargaCoret)}</p>
              ) : null}
              <div class="mt-0.5 flex flex-wrap items-center gap-2">
                {p.harga > 0 ? (
                  <p class="display text-3xl leading-none text-ink">{`Rp${formatIdr(p.harga)}`}</p>
                ) : (
                  <p class="display text-2xl leading-none text-ink">Info via WA</p>
                )}
                {hemat(p.hargaCoret, p.harga) > 0 && (
                  <span class="rounded-full bg-ink px-2 py-0.5 text-[10px] font-black tracking-wide text-brand uppercase">
                    Hemat {hemat(p.hargaCoret, p.harga)}%
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-[11px] text-ink">{p.satuan}</p>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-ink">{p.ringkasan}</p>

            <ul class="mt-4 space-y-2 text-[13px] text-ink">
              {p.didapat.slice(0, 5).map((d) => (
                <li class="flex gap-2">
                  <span class="text-ink" aria-hidden="true">
                    ✓
                  </span>
                  {d}
                </li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={waLink({ program: p.nama, source: `card-${p.slug}` })}
                target="_blank"
                rel="noopener noreferrer"
                data-wa-cta={`program-${p.slug}`}
                data-register
                data-program={p.nama}
                data-source={`program-${p.slug}`}
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-brand px-5 py-3.5 text-sm font-bold text-white transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
              >
                Daftar Sekarang ↗
              </a>
              <a
                href={`/program/${p.slug}`}
                class="rounded-xl px-2 py-3 text-xs font-bold text-ink transition hover:underline focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
              >
                Detail →
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Membership: kartu PERSIS pola kartu program (foto atas + isi bawah). -->
  <article class="spot prog-card group relative mt-6 flex flex-col overflow-hidden rounded-3xl">
    <div
      class="ticket relative aspect-21/9 overflow-hidden bg-paper-deep"
      style="--notch-y: 100%; --notch-bg: var(--color-paper-deep);"
    >
      <img
        src="/media/hero-athletes.jpg"
        alt="Atlet Prospect Asia berpose dengan piala juara"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
      <p class="absolute top-3 left-3 rounded-full bg-brand px-3 py-1 text-[10px] font-black tracking-widest text-white uppercase">
        Coming Soon
      </p>
      <p class="absolute bottom-3 left-4 max-w-[calc(100%-2rem)] rounded-2xl bg-ink/80 px-3 py-1.5 text-[11px] font-bold tracking-[0.16em] text-white uppercase">
        Membership · sesi rutin
      </p>
    </div>

    <div class="relative z-10 grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-10">
      <div>
        <div class="flex items-start justify-between gap-3">
          <h3 class="display text-3xl text-ink sm:text-4xl">Membership Program</h3>
          <span class="display shrink-0 text-4xl leading-none text-brand" aria-hidden="true">04</span>
        </div>

        <p class="mt-3 max-w-lg text-sm leading-relaxed text-ink sm:text-base">
          Satu langganan untuk sesi rutin, tanpa perlu booking ulang. Daftar early access buat dapat slot di batch pertama.
        </p>
      </div>

      <ul class="grid gap-2 sm:grid-cols-2">
        {membershipBenefits.map((b) => (
          <li class="flex items-start gap-2 text-[13px] text-ink">
            <span class="text-brand" aria-hidden="true">
              ✓
            </span>
            {b}
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={waLink({ program: 'Membership (early access)', source: 'membership' })}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-cta="membership"
          data-register
          data-program="Membership (early access)"
          data-source="membership"
          class="inline-flex items-center justify-center gap-2 rounded-2xl bg-brand px-7 py-4 text-sm font-bold text-white transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
        >
          Daftar Early Access ↗
        </a>
      </div>
    </div>
  </article>
  </div>
</section>
