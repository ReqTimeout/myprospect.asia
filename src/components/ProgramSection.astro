---
import { Image } from 'astro:assets';
import { waLink } from '../lib/wa';
import { programs, formatIdr } from '../data/programs';
import membershipArt from '../assets/generated/a3-membership.jpg';
---

<section id="program" class="relative mx-auto max-w-6xl overflow-hidden scroll-mt-20 px-4 py-14 sm:px-6">
  <div class="art-blob -top-20 -left-24 h-64 w-64" style="background: radial-gradient(circle, rgba(255,195,46,0.2), transparent 68%);" aria-hidden="true"></div>
  <div class="art-ring right-4 top-8 hidden h-20 w-20 border-crimson/20 sm:block" aria-hidden="true"></div>
  <div class="art-balls-orange absolute -top-6 right-0 h-40 w-40 opacity-60 [mask-image:linear-gradient(to_bottom_left,black,transparent)]" aria-hidden="true"></div>
  <div class="sport-ball sport-ball--orange left-[46%] top-24 hidden h-9 w-9 -rotate-12 lg:block" aria-hidden="true"></div>
  <p class="ghost-word bottom-2 right-0 hidden text-[5rem] lg:block" aria-hidden="true">1-on-1</p>
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="eyebrow text-xs font-bold tracking-[0.2em] text-brand-dark uppercase">Program Unggulan</p>
      <h2 class="display mt-2 text-4xl sm:text-5xl">Private 1-on-1<br />buat naik level</h2>
    </div>
    <p class="max-w-xs text-sm text-ink/60">
      Semua online, jadwal fleksibel, didampingi coach. Mulai dari tes penempatan dulu.
    </p>
  </div>

  <div class="grid gap-5 md:grid-cols-3" data-reveal-group>
    {
      programs.map((p) => (
        <article data-reveal="pop" class="card-soft group relative flex flex-col overflow-hidden rounded-3xl transition duration-200 hover:-translate-y-1 hover:border-brand/50 hover:shadow-[0_24px_50px_-24px_rgba(255,122,26,0.4)]">
          {p.badge && (
            <p
              class:list={[
                'px-5 py-2 text-[11px] font-black tracking-widest uppercase',
                p.badgeTone === 'gold' ? 'bg-gold text-ink' : 'bg-brand text-ink',
              ]}
            >
              {p.badge}
            </p>
          )}

          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="display text-2xl">{p.nama}</h3>
              {p.online && (
                <span class="rounded-full border border-ink/15 px-2 py-0.5 text-[10px] font-bold tracking-wide text-ink/60 uppercase">
                  Online
                </span>
              )}
            </div>
            <p class="mt-1 text-xs text-ink/50">{p.sub}</p>

            <div class="mt-5">
              {p.hargaCoret ? (
                <p class="text-sm text-ink/40 line-through">Rp{formatIdr(p.hargaCoret)}</p>
              ) : null}
              {p.harga > 0 ? (
                <p class="display text-3xl text-brand">Rp{formatIdr(p.harga)}</p>
              ) : (
                <p class="display text-2xl text-brand-dark">Info via WA</p>
              )}
              <p class="mt-0.5 text-[11px] text-ink/50">{p.satuan}</p>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-ink/70">{p.ringkasan}</p>

            <ul class="mt-4 space-y-2 text-[13px] text-ink/75">
              {p.didapat.slice(0, 5).map((d) => (
                <li class="flex gap-2">
                  <span class="text-brand-dark" aria-hidden="true">
                    ✓
                  </span>
                  {d}
                </li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={waLink({ program: p.nama, source: `card-${p.slug}` })}
                target="_blank"
                rel="noopener noreferrer"
                data-wa-cta={`program-${p.slug}`}
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-brand px-5 py-3.5 text-sm font-bold text-ink transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
              >
                Daftar via WhatsApp ↗
              </a>
              <a
                href={`/program/${p.slug}`}
                class="rounded-xl px-2 py-3 text-xs font-bold text-brand-dark transition hover:underline focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
              >
                Detail →
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="relative mt-6 flex flex-col items-start gap-4 overflow-hidden rounded-3xl bg-gradient-to-br from-brand via-brand to-brand-dark p-6 shadow-[0_24px_50px_-20px_rgba(255,122,26,0.6)] sm:flex-row sm:items-center sm:justify-between">
    <div class="art-stripes-light absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="relative">
      <p class="text-xs font-black tracking-widest text-white/80 uppercase">Coming Soon</p>
      <p class="display mt-1 text-2xl text-white">Membership Program</p>
      <p class="mt-1 text-sm text-white/85">Benefit berkelanjutan buat atlet — daftar early access dulu.</p>
    </div>
    <Image
      src={membershipArt}
      alt=""
      width={440}
      height={248}
      loading="lazy"
      aria-hidden="true"
      class="relative hidden h-24 w-44 rounded-2xl border border-white/30 object-cover sm:block"
    />
    <a
      href={waLink({ program: 'Membership (early access)', source: 'membership' })}
      target="_blank"
      rel="noopener noreferrer"
      data-wa-cta="membership"
      class="relative rounded-2xl bg-white px-5 py-3 text-sm font-bold text-ink transition hover:bg-gold-soft focus-visible:ring-2 focus-visible:ring-ink focus-visible:outline-none active:scale-95"
    >
      Info Early Access ↗
    </a>
  </div>
</section>
