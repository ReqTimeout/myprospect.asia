---
import { waLink } from '../lib/wa';
import { programs, formatIdr } from '../data/programs';
import SportArt from './SportArt.astro';
import ProgramBackdrop from './ProgramBackdrop.astro';
import Chapter from './Chapter.astro';

const programPhoto: Record<string, string> = {
  'elite-1on1': '/media/session-elite.jpg',
  'premium-1on1': '/media/session-premium.jpg',
  'small-group': '/media/session-smallgroup.jpg',
};

const membershipBenefits = [
  'Sesi rutin tanpa ribet booking ulang',
  'Materi & e-library eksklusif atlet',
  'Priority support dari coach',
  'Community atlet lintas cabang',
];

const hemat = (coret: number | undefined, harga: number) =>
  coret && coret > harga ? Math.round(((coret - harga) / coret) * 100) : 0;
---

<section id="program" class="relative mx-auto max-w-6xl overflow-hidden scroll-mt-20 px-4 py-14 sm:px-6">
  <div class="art-blob -top-20 -left-24 h-64 w-64" style="background: radial-gradient(circle, rgba(255,195,46,0.2), transparent 68%);" aria-hidden="true"></div>
  <div class="art-ring right-4 top-8 hidden h-20 w-20 border-crimson/20 sm:block" aria-hidden="true"></div>
  <div class="art-balls-orange absolute -top-6 right-0 h-40 w-40 opacity-60 [mask-image:linear-gradient(to_bottom_left,black,transparent)]" aria-hidden="true"></div>
  <div class="sport-ball sport-ball--orange left-[46%] top-24 hidden h-9 w-9 -rotate-12 lg:block" aria-hidden="true"></div>
  <p class="ghost-word ghost-word--light bottom-2 right-0 hidden text-[5rem] lg:block" aria-hidden="true">1-on-1</p>
  <ProgramBackdrop />
  <div class="mb-8 relative z-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <Chapter num="05" label="Program Unggulan" tone="light" class="mb-6" />
      <h2 class="display text-5xl leading-[0.9] sm:text-6xl lg:text-7xl text-white">
        Private 1-on-1<br />
        <span class="text-brand">buat naik level</span>
      </h2>
    </div>
    <p class="max-w-xs text-sm leading-relaxed text-white/70">
      Semua online, jadwal fleksibel, didampingi coach. Mulai dari tes penempatan dulu.
    </p>
  </div>

  <div class="relative z-10 grid gap-5 md:grid-cols-3" data-reveal-group>
    {
      programs.map((p, i) => (
        <article
          data-reveal="pop"
          data-spot
          class="spot prog-card group relative flex flex-col overflow-hidden rounded-3xl"
        >
          <div
            class="ticket relative aspect-16/10 overflow-hidden bg-paper-deep"
            style="--notch-y: 100%; --notch-bg: var(--color-paper);"
          >
            <img
              src={programPhoto[p.slug]}
              alt={`Atlet mengikuti sesi ${p.nama} bersama coach Prospect Asia`}
              loading="lazy"
              width="1376"
              height="768"
              class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/15 to-transparent"></div>
            {p.badge && (
              <p
                class:list={[
                  'absolute top-3 left-3 rounded-full px-3 py-1 text-[10px] font-black tracking-widest uppercase shadow-sm',
                  p.badgeTone === 'gold' ? 'bg-gold text-ink' : 'bg-brand text-ink',
                ]}
              >
                {p.badge}
              </p>
            )}
            {p.online && (
              <span class="live-badge absolute top-3 right-3">
                <span class="live-dot" aria-hidden="true"></span>
                Online
              </span>
            )}
            <p class="absolute bottom-3 left-4 max-w-[calc(100%-2rem)] rounded-2xl bg-ink/80 px-3 py-1.5 text-[11px] font-bold tracking-[0.16em] text-white uppercase">
              {p.sub}
            </p>
          </div>

          <div class="relative z-10 flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="display text-2xl text-ink">{p.nama}</h3>
              <span class="display shrink-0 text-4xl leading-none text-brand-dark">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="mt-4">
              {p.hargaCoret ? (
                <p class="text-sm text-ink/65 line-through">Rp{formatIdr(p.hargaCoret)}</p>
              ) : null}
              <div class="mt-0.5 flex flex-wrap items-center gap-2">
                {p.harga > 0 ? (
                  <p class="display text-3xl leading-none text-brand-dark">Rp{formatIdr(p.harga)}</p>
                ) : (
                  <p class="display text-2xl leading-none text-brand-dark">Info via WA</p>
                )}
                {hemat(p.hargaCoret, p.harga) > 0 && (
                  <span class="rounded-full bg-brand px-2 py-0.5 text-[10px] font-black tracking-wide text-ink uppercase">
                    Hemat {hemat(p.hargaCoret, p.harga)}%
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-[11px] text-ink/65">{p.satuan}</p>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-ink/70">{p.ringkasan}</p>

            <ul class="mt-4 space-y-2 text-[13px] text-ink/75">
              {p.didapat.slice(0, 5).map((d) => (
                <li class="flex gap-2">
                  <span class="text-brand-dark" aria-hidden="true">
                    ✓
                  </span>
                  {d}
                </li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={waLink({ program: p.nama, source: `card-${p.slug}` })}
                target="_blank"
                rel="noopener noreferrer"
                data-wa-cta={`program-${p.slug}`}
                data-register
                data-program={p.nama}
                data-source={`program-${p.slug}`}
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-brand px-5 py-3.5 text-sm font-bold text-ink transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
              >
                Daftar Sekarang ↗
              </a>
              <a
                href={`/program/${p.slug}`}
                class="rounded-xl px-2 py-3 text-xs font-bold text-brand-dark transition hover:underline focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
              >
                Detail →
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="relative z-10 mt-6 overflow-hidden rounded-3xl bg-[#1c1208] shadow-[0_28px_60px_-24px_rgba(0,0,0,0.6)] ring-1 ring-white/12">
    <img
      src="/media/program-elite.jpg"
      alt=""
      loading="lazy"
      class="ken-burns absolute inset-0 h-full w-full object-cover opacity-70"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-ink/20" aria-hidden="true"></div>
    <SportArt variant="stadium" stroke="#ffffff" opacity={0.18} class="absolute inset-0 h-full w-full" />
    <div class="relative grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-gold px-3 py-1 text-[10px] font-black tracking-widest text-ink uppercase">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-ink"></span>
          Coming Soon
        </span>
        <h3 class="display mt-3 text-3xl text-white sm:text-4xl">Membership Program</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-white/85">
          Benefit berkelanjutan buat atlet — daftar early access dulu biar dapat slot lebih awal.
        </p>
        <ul class="mt-5 grid gap-2 sm:grid-cols-2">
          {membershipBenefits.map((b) => (
            <li class="flex items-start gap-2 text-[13px] text-white/90">
              <span class="mt-0.5 text-gold" aria-hidden="true">
                ✓
              </span>
              {b}
            </li>
          ))}
        </ul>
      </div>

      <div class="relative lg:justify-self-end">
        <div class="vip-card p-5 sm:p-6">
          <span class="vip-card__shine" aria-hidden="true"></span>
          <span class="vip-card__corner left-3 top-3 border-l border-t" aria-hidden="true"></span>
          <span class="vip-card__corner right-3 top-3 border-r border-t" aria-hidden="true"></span>
          <span class="vip-card__corner bottom-3 left-3 border-b border-l" aria-hidden="true"></span>
          <span class="vip-card__corner right-3 bottom-3 border-r border-b" aria-hidden="true"></span>

          <p class="text-[10px] font-black tracking-[0.24em] text-gold uppercase">Early Access</p>
          <p class="display mt-2 text-3xl text-white">Slot terbatas</p>
          <div class="vip-rule my-3.5"></div>
          <p class="text-[12px] leading-relaxed text-white/78">
            Daftar sekarang, dapat prioritas tempat di batch pertama.
          </p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-gold/45 bg-gold/12 px-3 py-1 text-[10px] font-black tracking-[0.18em] text-gold uppercase">
            Batch 01 · Kuota awal
          </p>
          <a
            href={waLink({ program: 'Membership (early access)', source: 'membership' })}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-cta="membership"
            data-register
            data-program="Membership (early access)"
            data-source="membership"
            class="vip-cta mt-4 inline-flex w-full items-center justify-center gap-2 rounded-2xl px-5 py-3.5 text-sm font-bold text-ink transition focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none active:scale-95"
          >
            Daftar Early Access ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
