---
import { coaches } from '../data/coaches';
import Chapter from './Chapter.astro';
import SectionImage from './SectionImage.astro';
import { waLink } from '../lib/wa';

const doubled = [...coaches, ...coaches];
---

<section class="relative overflow-hidden py-10 sm:py-14">
  <SectionImage src="/media/docs-1.jpg" pos="tl" opacity={0.28} />
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">

  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <Chapter num="08" label="Coach" class="mb-6" />
      <h2 class="display text-5xl leading-[0.9] sm:text-6xl">
        Didampingi<br />
        <span class="hl-swash text-ink">yang sudah turun lapangan</span>
      </h2>
    </div>
    <p class="max-w-sm text-sm leading-relaxed text-ink">
      Enam coach pendamping, dipimpin ex-media PERSIB Bandung &amp; PSSI. Formatnya satu-on-one atau small group,
      jadi atlet tetap dibimbing langsung.
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-stretch">
    <div class="rail-wrap -mx-4 px-4 sm:mx-0 sm:px-0">
      <div class="rail" style="--rail-speed: 58s">
        {
          doubled.map((c, i) => (
            <article
              class="spot card-soft card-lift group relative flex w-48 shrink-0 flex-col overflow-hidden rounded-3xl sm:w-56"
            >
              {/* Foto asli coach dari materi klien; pola jersey hanya cadangan kalau belum ada foto.
                  Kotak 1:1 + object-top: wajah utuh, hanya bagian bawah foto yang terpotong. */}
              <div class="relative aspect-1/1 overflow-hidden bg-paper-deep">
                {c.foto ? (
                  <img
                    src={c.foto}
                    alt={`Coach ${c.nama}`}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover object-top"
                  />
                ) : (
                  <div class="jersey absolute inset-0"></div>
                )}
              </div>

              <div class="relative z-10 flex flex-1 flex-col p-4">
                <h3 class="text-base font-bold">{c.nama}</h3>
                <p class="mt-0.5 text-[11px] font-bold tracking-wide text-ink uppercase">{c.peran}</p>
                {c.detail && (
                  <p class="mt-1.5 text-[10px] leading-snug font-semibold text-ink/70">{c.detail}</p>
                )}

                <div class="mt-auto pt-3">
                  <div class="border-t border-ink/10"></div>
                  <a
                    href={waLink({ program: `Sesi 1-on-1 bersama ${c.nama}`, source: `coach-${i % coaches.length}` })}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-wa-cta={`coach-${i % coaches.length}`}
                    data-register
                    data-program={`Sesi 1-on-1 bersama ${c.nama}`}
                    data-source={`coach-${i % coaches.length}`}
                    class="-mx-1 mt-2 flex items-center justify-between gap-2 px-1 py-2 text-[12px] font-bold text-ink transition hover:text-brand focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
                  >
                    Booking bersama {c.nama.split(' ')[0]}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <aside class="relative hidden overflow-hidden rounded-3xl border border-ink/10 shadow-soft lg:block">
      <img
        src="/media/mic-kid.jpg"
        alt="Atlet muda siap berbicara di depan mikrofon"
        width="857"
        height="1063"
        loading="lazy"
        class="h-full max-h-96 w-full object-cover lg:max-h-none"
      />
      <div class="absolute right-4 bottom-4 left-4 rounded-2xl bg-ink px-4 py-3">
        <p class="display text-2xl leading-tight text-white">“Takut salah ngomong?”</p>
        <p class="mt-1 text-xs leading-relaxed text-white">
          Latihan microphone, simulasi wawancara, dan latihan percaya diri seperti di depan wartawan.
        </p>
      </div>
    </aside>
  </div>
  </div>
</section>
