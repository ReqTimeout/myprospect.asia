---
import { coaches } from '../data/coaches';
import Chapter from './Chapter.astro';
import SectionImage from './SectionImage.astro';
import { waLink } from '../lib/wa';

const doubled = [...coaches, ...coaches];
const posisi = ['GK', 'CB', 'CM', 'ST', 'WF', 'PG'];
const fokus = ['Public Speaking', 'Simulasi Wawancara Media', 'English for Athletes'];
const skill = [88, 74, 62];
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
  <SectionImage src="/media/sections/coach.webp" pos="tl" opacity={0.6} />

  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <Chapter num="08" label="Coach" class="mb-6" />
      <h2 class="display text-5xl leading-[0.9] sm:text-6xl">
        Didampingi<br />
        <span class="hl-swash text-ink">yang sudah turun lapangan</span>
      </h2>
    </div>
    <p class="max-w-sm text-sm leading-relaxed text-ink/70">
      Enam coach berlisensi, dari ex-media PERSIB &amp; PSSI sampai atlet JPN berprestasi. Formatnya satu-on-one atau
      small group, jadi atlet tetap dibimbing langsung.
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-stretch">
    <div class="rail-wrap -mx-4 px-4 sm:mx-0 sm:px-0">
      <div class="rail" style="--rail-speed: 58s">
        {
          doubled.map((c, i) => (
            <article
              class="spot card-soft card-lift group relative flex w-60 shrink-0 flex-col overflow-hidden rounded-3xl sm:w-64"
            >
              <div class="relative aspect-16/11 overflow-hidden bg-ink">
                <div class="jersey absolute inset-0"></div>
                <div class="absolute inset-0 bg-ink/70"></div>
                <span class="display absolute top-1 right-3 text-6xl leading-none text-white/25 italic" aria-hidden="true">
                  {String((i % coaches.length) + 1).padStart(2, '0')}
                </span>
                <span class="absolute bottom-1 left-4 display text-5xl leading-none text-white/95 italic">
                  {c.nama[0]}
                </span>
                <span class="absolute right-3 bottom-3 rounded-full bg-brand px-2 py-0.5 text-[9px] font-black tracking-widest text-ink uppercase">
                  {posisi[i % posisi.length]}
                </span>
              </div>

              <div class="relative z-10 flex flex-1 flex-col p-5">
                <h3 class="text-base font-bold">{c.nama}</h3>
                <p class="mt-0.5 text-[11px] font-bold tracking-wide text-ink/70 uppercase">{c.peran}</p>

                <div class="mt-3 flex flex-wrap gap-1.5">
                  {c.ielts && (
                    <span class="rounded-full bg-brand-soft px-2 py-0.5 text-[10px] font-bold text-ink">
                      IELTS Certified
                    </span>
                  )}
                  {c.stat && (
                    <span class="rounded-full border border-ink/15 px-2 py-0.5 text-[10px] font-bold text-ink/70">
                      {c.stat}
                    </span>
                  )}
                  {c.olahraga && (
                    <span class="rounded-full border border-ink/15 px-2 py-0.5 text-[10px] font-bold text-ink/70">
                      {c.olahraga}
                    </span>
                  )}
                </div>

                {c.bio && <p class="mt-3 text-[13px] leading-relaxed text-ink/70">{c.bio}</p>}

                <div class="mt-4 flex flex-1 flex-col justify-center gap-3">
                  {fokus.map((f, k) => (
                    <div>
                      <div class="flex items-center justify-between gap-2 text-[11px] font-bold text-ink/70">
                        <span class="min-w-0 truncate">{f}</span>
                        <span class="shrink-0 text-ink" aria-hidden="true">
                          ✓
                        </span>
                      </div>
                      <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-ink/8">
                        <div
                          class="h-full rounded-full bg-brand"
                          style={`width:${skill[(k + i) % skill.length]}%`}
                        >
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="mt-auto pt-4">
                  <div class="border-t border-ink/10"></div>
                  <a
                    href={waLink({ program: `Sesi 1-on-1 bersama ${c.nama}`, source: `coach-${i % coaches.length}` })}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-wa-cta={`coach-${i % coaches.length}`}
                    data-register
                    data-program={`Sesi 1-on-1 bersama ${c.nama}`}
                    data-source={`coach-${i % coaches.length}`}
                    class="-mx-1 mt-2 flex items-center justify-between gap-2 px-1 py-2 text-[12px] font-bold text-ink transition hover:text-brand focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
                  >
                    Booking bersama {c.nama.split(' ')[0]}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <aside class="relative overflow-hidden rounded-3xl border border-ink/10 shadow-soft">
      <img
        src="/media/mic-kid.jpg"
        alt="Atlet muda siap berbicara di depan mikrofon"
        width="857"
        height="1063"
        loading="lazy"
        class="h-full max-h-96 w-full object-cover lg:max-h-none"
      />
      <div class="absolute right-4 bottom-4 left-4 rounded-2xl bg-ink px-4 py-3">
        <p class="display text-2xl leading-tight text-white">“Takut salah ngomong?”</p>
        <p class="mt-1 text-xs leading-relaxed text-white/85">
          Latihan microphone, simulasi wawancara, dan latihan percaya diri seperti di depan wartawan.
        </p>
      </div>
    </aside>
  </div>
</section>
