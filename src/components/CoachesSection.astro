---
import { coaches } from '../data/coaches';
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
  <div class="art-blob -bottom-24 -left-24 h-64 w-64" style="background: radial-gradient(circle, rgba(255,122,26,0.14), transparent 68%); animation-delay: -9s;" aria-hidden="true"></div>
  <div class="art-diamond -top-2 right-24 h-2.5 w-2.5 bg-crimson/60 hidden sm:block" aria-hidden="true"></div>
  <div class="art-court absolute inset-0 opacity-70 [mask-image:linear-gradient(to_left,black,transparent_65%)]" aria-hidden="true"></div>
  <div class="sport-ball sport-ball--orange right-[8%] bottom-16 hidden h-10 w-10 rotate-12 xl:block" aria-hidden="true"></div>
  <p class="ghost-word top-4 -right-2 hidden text-[4.5rem] lg:block" aria-hidden="true">Coach</p>
  <div class="mb-8">
    <p class="eyebrow text-xs font-bold tracking-[0.2em] text-brand-dark uppercase">Sports Communication Coaches</p>
    <h2 class="display mt-2 text-4xl sm:text-5xl">Didampingi<br />yang sudah turun lapangan</h2>
  </div>

  <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0" style="scrollbar-width: thin;">
    {
      coaches.map((c) => (
        <article class="card-soft card-lift group w-56 shrink-0 snap-start rounded-3xl p-5 sm:w-64">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand to-brand-dark display text-2xl text-ink italic">
            {c.nama[0]}
          </div>
          <h3 class="mt-4 text-base font-bold">{c.nama}</h3>
          <p class="mt-0.5 text-xs text-ink/55">{c.peran}</p>

          <div class="mt-3 flex flex-wrap gap-1.5">
            {c.ielts && (
              <span class="rounded-full border border-gold/40 bg-gold/10 px-2 py-0.5 text-[10px] font-bold text-brand-dark">
                IELTS Certified
              </span>
            )}
            {c.stat && (
              <span class="rounded-full border border-ink/15 px-2 py-0.5 text-[10px] font-bold text-ink/70">
                {c.stat}
              </span>
            )}
            {c.olahraga && (
              <span class="rounded-full border border-ink/15 px-2 py-0.5 text-[10px] font-bold text-ink/70">
                {c.olahraga}
              </span>
            )}
          </div>

          {c.bio && <p class="mt-3 text-[13px] leading-relaxed text-ink/60">{c.bio}</p>}
        </article>
      ))
    }
  </div>
</section>
