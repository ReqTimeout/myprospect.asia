---
import { faqs } from '../data/faq';
import FaqAccordion from './islands/FaqAccordion.svelte';
import Chapter from './Chapter.astro';
import { waLink } from '../lib/wa';
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
  <div class="art-blob -top-16 -left-20 h-56 w-56" style="background: radial-gradient(circle, rgba(255,195,46,0.18), transparent 68%);" aria-hidden="true"></div>
  <div class="art-balls absolute inset-0 opacity-50 [mask-image:linear-gradient(to_left,black,transparent_55%)]" aria-hidden="true"></div>

  <div class="relative grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    <div class="relative lg:sticky lg:top-24">
      <Chapter num="10" label="FAQ" class="mb-6" />
      <h2 class="display text-4xl leading-[0.95] sm:text-5xl lg:text-6xl">
        Pertanyaan yang<br />sering muncul
      </h2>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink/65">
        Belum ketemu jawabannya? Admin kami bantu langsung — balas cepat di jam kerja.
      </p>
      <a
        href={waLink({ source: 'faq' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="faq"
        class="mt-6 inline-flex items-center gap-2 rounded-2xl bg-brand px-5 py-3.5 text-sm font-bold text-ink transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
      >
        Tanya admin ↗
      </a>

      <div class="art-panel mt-8 rounded-3xl border border-ink/10 bg-white p-5 shadow-soft">
        <div class="flex items-start justify-between gap-4">
          <p class="display text-4xl leading-none text-brand-dark">2.175+</p>
          <span
            class="display shrink-0 rounded-2xl bg-brand/12 px-3 py-1.5 text-2xl leading-none text-brand-dark"
            aria-hidden="true">?</span
          >
        </div>
        <p class="mt-3 text-xs leading-relaxed text-ink/60">
          atlet sudah dilatih bicara di depan publik — dan terus bertambah tiap bulan.
        </p>
      </div>
    </div>

    <div class="relative">
      <FaqAccordion client:visible items={faqs.slice(0, 5)} limit={5} />
    </div>
  </div>
</section>