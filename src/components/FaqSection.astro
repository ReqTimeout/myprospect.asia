---
import { faqs } from '../data/faq';
import FaqAccordion from './islands/FaqAccordion.svelte';
import Chapter from './Chapter.astro';
import SectionImage from './SectionImage.astro';
import { waLink } from '../lib/wa';
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
  <SectionImage src="/media/sections/faq.webp" pos="tl" opacity={0.62} />
  <div class="relative grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    <div class="relative lg:sticky lg:top-24">
      <Chapter num="10" label="FAQ" class="mb-6" />
      <h2 class="display text-4xl leading-[0.95] sm:text-5xl lg:text-6xl">
        Pertanyaan yang<br />sering muncul
      </h2>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink">
        Belum ketemu jawabannya? Admin kami bantu langsung, balas cepat di jam kerja.
      </p>
      <a
        href={waLink({ source: 'faq' })}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-cta="faq"
        class="mt-6 inline-flex items-center gap-2 rounded-2xl bg-brand px-5 py-3.5 text-sm font-bold text-white transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
      >
        Tanya admin ↗
      </a>

      <div class="art-panel mt-8 rounded-3xl border border-ink/10 bg-white p-5 shadow-soft">
        <div class="flex items-start justify-between gap-4">
          <p class="display text-4xl leading-none text-brand">2.175+</p>
          <span
            class="display shrink-0 rounded-2xl bg-brand px-3 py-1.5 text-2xl leading-none text-white"
            aria-hidden="true">?</span
          >
        </div>
        <p class="mt-3 text-xs leading-relaxed text-ink">
          atlet sudah dilatih bicara di depan publik, dan terus bertambah tiap bulan.
        </p>
      </div>
    </div>

    <div class="relative">
      <FaqAccordion client:visible items={faqs.slice(0, 5)} limit={5} />
    </div>
  </div>
</section>