---
import { faqs } from '../data/faq';
import FaqAccordion from './islands/FaqAccordion.svelte';
---

<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
  <div class="mb-8 text-center">
    <p class="text-xs font-bold tracking-[0.2em] text-gold uppercase">FAQ</p>
    <h2 class="display mt-2 text-4xl sm:text-5xl">Pertanyaan yang<br />sering muncul</h2>
  </div>

  <FaqAccordion client:visible items={faqs.slice(0, 5)} limit={5} />
</section>
