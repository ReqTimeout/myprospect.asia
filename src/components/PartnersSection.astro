---
import Chapter from './Chapter.astro';
import PartnerLogo from './PartnerLogo.astro';
import { partners } from '../data/partners';

// Jumlah kolom per kelompok dipilih supaya baris terisi penuh di HP:
// 6 akademi → 3 kolom (2 baris), 4 mitra → 2 kolom (2 baris).
const grup = [
  { key: 'akademi', judul: 'Akademi & klub', cols: 'grid-cols-3 sm:grid-cols-4 lg:grid-cols-6' },
  { key: 'mitra', judul: 'Mitra pendukung', cols: 'grid-cols-2 sm:grid-cols-4 lg:grid-cols-6' },
];
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
  <div class="art-track absolute inset-x-0 bottom-0 h-24 opacity-40 [mask-image:linear-gradient(to_top,black,transparent)]" aria-hidden="true"></div>

  <div class="relative">
    <Chapter num="02" label="Mitra & Akademi" />

    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="display max-w-lg text-4xl leading-[0.95] sm:text-5xl lg:text-6xl">
        Bekerja sama dengan<br />
        <span class="text-brand-text">akademi & mitra</span>
      </h2>
      <p class="max-w-sm text-sm leading-relaxed text-ink/70">
        Klub olahraga, akademi, dan mitra pendukung yang sudah dilatih bareng tim Prospect Asia.
      </p>
    </div>

    <div class="mt-8 space-y-8">
      {
        grup.map((g) => {
          const items = partners.filter((p) => p.jenis === g.key);
          return (
            <div>
              <div class="flex items-baseline gap-3">
                <h3 class="display text-lg tracking-tight sm:text-xl">{g.judul}</h3>
                <span class="text-[11px] font-bold tracking-widest text-ink/70 uppercase">{items.length} {g.key === 'akademi' ? 'akademi' : 'mitra'}</span>
                <span class="chapter-rule" aria-hidden="true" />
              </div>
              <ul class={`mt-4 grid gap-2 ${g.cols}`} data-reveal-group>
                {items.map((p, i) => (
                  <li
                    data-reveal="pop"
                    class="group flex flex-col items-center justify-center gap-2 rounded-xl border border-ink/10 bg-white p-2.5 text-center transition duration-300 hover:-translate-y-0.5 hover:border-brand sm:p-3"
                    style={`transition-delay:${Math.min(i * 50, 300)}ms`}
                  >
                    <span class="relative flex h-10 w-full items-center justify-center sm:h-12">
                      <PartnerLogo slug={p.slug} nama={p.nama} crest={p.crest} />
                    </span>
                    <span class="block text-[11px] leading-tight font-bold text-ink transition group-hover:text-brand-text sm:text-xs">
                      {p.nama}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
