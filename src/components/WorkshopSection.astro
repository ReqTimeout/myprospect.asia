---
import { waLink } from '../lib/wa';
import { workshops, formatIdr } from '../data/workshops';
---

<section id="workshop" class="relative mx-auto max-w-6xl overflow-hidden scroll-mt-20 px-4 py-14 sm:px-6">
  <div class="art-dots absolute inset-x-0 top-0 h-40 opacity-50 [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
  <div class="art-blob top-24 -right-28 h-72 w-72" style="background: radial-gradient(circle, rgba(255,195,46,0.18), transparent 68%); animation-delay: -5s;" aria-hidden="true"></div>
  <div class="art-track absolute inset-x-0 bottom-0 h-56 opacity-70" aria-hidden="true"></div>
  <div class="art-pitch-orange absolute inset-x-0 bottom-0 h-72 opacity-50 [mask-image:linear-gradient(to_top,black,transparent_70%)]" aria-hidden="true"></div>
  <div class="sport-ball left-5 bottom-24 hidden h-14 w-14 -rotate-12 lg:block" aria-hidden="true"></div>
  <div class="pointer-events-none absolute right-6 top-10 hidden -rotate-6 rounded-2xl border-3 border-crimson/25 bg-white px-3.5 py-1.5 shadow-soft sm:block" aria-hidden="true">
    <span class="display text-base text-crimson">GO!</span>
  </div>
  <div class="mb-8 grid items-center gap-6 md:grid-cols-[1.2fr_1fr]">
    <div class="max-w-2xl">
      <p class="eyebrow text-xs font-bold tracking-[0.2em] text-brand-dark uppercase">Kolaborasi Akademi / Klub</p>
      <h2 class="display mt-2 text-4xl sm:text-5xl">Workshop buat<br />atlet binaanmu</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink/65 sm:text-base">
        Sesi 90–120 menit, interaktif, praktik langsung. Minimal 10 peserta — didampingi coach Sports Communication.
      </p>
    </div>
    <img
      src="/media/workshop-live.jpg"
      alt="Atlet akademi mengikuti Sports Communication Workshop bersama coach Prospect Asia"
      width="1280"
      height="853"
      loading="lazy"
      class="hidden rounded-3xl border border-ink/10 md:block"
    />
  </div>

  <div class="grid gap-5 md:grid-cols-3" data-reveal-group>
    {
      workshops.map((w) => (
        <article data-reveal="pop" class="card-soft card-lift flex flex-col rounded-3xl p-6">
          <div class="flex items-center justify-between gap-2">
            <h3 class="display text-2xl">{w.nama}</h3>
            <span class="rounded-full border border-ink/15 px-2.5 py-1 text-[10px] font-bold text-ink/60">{w.durasi}</span>
          </div>

          <div class="mt-4">
            {w.harga > 0 ? (
              <p class="display text-3xl text-brand-dark">Rp{formatIdr(w.harga)}</p>
            ) : (
              <p class="display text-2xl text-brand-dark">Custom</p>
            )}
            <p class="mt-0.5 text-[11px] text-ink/50">per sesi · {w.target}</p>
            {w.catatan && <p class="mt-1 text-[11px] font-black text-brand-dark">{w.catatan}</p>}
          </div>

          <p class="mt-4 text-sm leading-relaxed text-ink/70">{w.ringkasan}</p>

          <ul class="mt-4 flex-1 space-y-2 text-[13px] text-ink/75">
            {w.didapat.map((d) => (
              <li class="flex gap-2">
                <span class="text-brand-dark" aria-hidden="true">
                  ✓
                </span>
                {d}
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              href={waLink({ program: w.nama, source: `workshop-${w.slug}` })}
              target="_blank"
              rel="noopener noreferrer"
              data-wa-cta={`workshop-${w.slug}`}
              class="inline-flex items-center justify-center gap-2 rounded-2xl border border-gold px-5 py-3.5 text-sm font-bold text-brand-dark transition hover:bg-gold hover:text-ink focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
            >
              Booking via WhatsApp ↗
            </a>
            <a
              href={`/workshop/${w.slug}`}
              class="rounded-xl px-2 py-3 text-xs font-bold text-brand-dark transition hover:underline focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none"
            >
              Detail →
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
