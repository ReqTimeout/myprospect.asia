---
import { waLink } from '../lib/wa';
import { workshops, formatIdr } from '../data/workshops';
import AutoGallery from './AutoGallery.astro';
import SectionImage from './SectionImage.astro';
import Chapter from './Chapter.astro';

const gallery = [
  {
    src: '/media/workshop-live.jpg',
    alt: 'Atlet akademi mengikuti Sports Communication Workshop bersama coach Prospect Asia',
  },
  {
    src: '/media/workshop-live-2.jpg',
    alt: 'Sesi simulasi wawancara atlet di workshop Prospect Asia',
  },
  {
    src: '/media/workshop-crowd.jpg',
    alt: 'Suasana workshop Prospect Asia bersama atlet akademi mitra',
  },
];
---

<section id="workshop" class="relative mx-auto max-w-6xl overflow-hidden scroll-mt-20 px-4 py-14 sm:px-6">
  <SectionImage src="/media/workshop-crowd.jpg" pos="tl" opacity={0.28} />
  <div class="pointer-events-none absolute right-6 top-10 hidden -rotate-6 rounded-2xl border-3 border-ink/15 bg-white px-3.5 py-1.5 shadow-soft sm:block" aria-hidden="true">
    <span class="display text-base text-brand">GO!</span>
  </div>

  <div class="mb-8 grid items-center gap-8 md:grid-cols-[1.1fr_1fr]">
    <div class="max-w-2xl">
      <Chapter num="06" label="Workshop" class="mb-6" />
      <h2 class="display text-5xl leading-[0.9] sm:text-6xl lg:text-7xl">
        Workshop untuk<br />
        <span class="text-brand">akademi &amp; klub</span>
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink sm:text-base">
        Sesi 90–120 menit, langsung praktik. Minimal 10 peserta, tetap dibimbing coach Sports Communication.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="rounded-full border border-ink/12 bg-white px-3 py-1.5 text-[11px] font-bold tracking-wide text-ink">
          2.175+ atlet teredukasi
        </span>
        <span class="rounded-full border border-ink/12 bg-white px-3 py-1.5 text-[11px] font-bold tracking-wide text-ink">
          25 akademi mitra
        </span>
        <span class="rounded-full border border-ink/12 bg-white px-3 py-1.5 text-[11px] font-bold tracking-wide text-ink">
          Sesi 90–120 menit
        </span>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-3xl border border-ink/10 shadow-[0_28px_60px_-30px_rgba(27,27,31,0.45)]">
      <AutoGallery
        images={gallery}
        step={5}
        class="aspect-4/3 w-full"
        imgClass="h-full w-full object-cover"
      />
      <span class="pointer-events-none absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-[10px] font-black tracking-widest text-white uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>
        Live
      </span>
      <span class="pointer-events-none absolute bottom-3 left-4 rounded-full bg-ink px-3 py-1.5 text-[11px] font-bold tracking-[0.16em] text-white uppercase">
        Suasana di lapangan
      </span>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-3" data-reveal-group>
    {
      workshops.map((w, i) => (
        <article data-reveal="pop" class="spot card-soft card-lift flex flex-col overflow-hidden rounded-3xl">
          <!-- Pita kepala seperti tiket: durasi + nomor, teks putih di atas arang. -->
          <div class="relative flex items-center justify-between gap-3 bg-ink px-5 py-3.5">
            <span class="text-[10px] font-black tracking-[0.2em] text-white uppercase">{w.durasi}</span>
            <span class="display text-2xl leading-none text-white" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>

          <div class="relative z-10 flex flex-1 flex-col p-6">
            <h3 class="display text-2xl leading-tight">{w.nama}</h3>
            <p class="mt-2 text-[11px] text-ink">
              {w.didapat.length} benefit · untuk akademi &amp; klub
            </p>

            <!-- Semua detail (harga, ringkasan, benefit) masuk satu toggle —
                 kartu hanya menampilkan nama, durasi, dan jumlah benefit
                 (permintaan klien: "yang tampil hanya ini saja"). -->
            <details class="group mt-5 border-t border-ink/10 pt-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-xs font-bold text-ink transition hover:text-brand">
                Lihat detail &amp; harga
                <span class="shrink-0 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="mt-3 border-l-2 border-brand/40 pl-3">
                {w.harga > 0 ? (
                  <p class="display text-3xl leading-none text-ink">Rp{formatIdr(w.harga)}</p>
                ) : (
                  <p class="display text-3xl leading-none text-ink">Custom</p>
                )}
                <p class="mt-1.5 text-[11px] text-ink">per sesi · {w.target}</p>
                <p class="mt-1.5 text-[11px] font-black text-ink">{w.catatan ?? ''}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink">{w.ringkasan}</p>
                <ul class="mt-3 space-y-2 text-[13px] text-ink">
                  {w.didapat.map((d) => (
                    <li class="flex gap-2">
                      <span class="text-brand" aria-hidden="true">
                        ✓
                      </span>
                      {d}
                    </li>
                  ))}
                </ul>
              </div>
            </details>

            <div class="mt-auto pt-5">
              <a
                href={waLink({ program: w.nama, source: `workshop-${w.slug}` })}
                target="_blank"
                rel="noopener noreferrer"
                data-wa-cta={`workshop-${w.slug}`}
                data-register
                data-program={w.nama}
                data-source={`workshop-${w.slug}`}
                class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-brand px-5 py-3.5 text-sm font-bold text-white transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
              >
                Booking Sekarang ↗
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
