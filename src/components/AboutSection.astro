---
import Chapter from './Chapter.astro';

const chips = ['Fun Communication for Active Kids', 'Sports Communication for Young Athletes', 'Digital Literacy & Personal Branding'];
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-14 sm:px-6">
  <div class="art-blob -right-28 bottom-0 h-72 w-72" style="background: radial-gradient(circle, rgba(255,122,26,0.16), transparent 68%);" aria-hidden="true"></div>
  <div class="pat-grid absolute inset-0 opacity-60 [mask-image:linear-gradient(to_bottom_left,transparent,black_65%)]" aria-hidden="true"></div>
  <div class="art-pitch absolute inset-0 opacity-70 [mask-image:linear-gradient(to_right,black,transparent_70%)]" aria-hidden="true"></div>
  <div class="sport-ball sport-ball--orange right-5 bottom-16 h-14 w-14 rotate-12 opacity-90" aria-hidden="true"></div>
  <div class="sport-ball top-10 right-[42%] hidden h-10 w-10 -rotate-12 opacity-80 lg:block" aria-hidden="true"></div>
  <p class="ghost-word -top-2 right-2 hidden text-[5.5rem] lg:block" aria-hidden="true">Speak</p>

  <Chapter num="03" label="Tentang Program" class="mb-6" />

  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
    <div class="relative order-2 md:order-1">
      <div data-reveal="fade" class="grain relative rotate-[-1.5deg] overflow-hidden rounded-3xl border-4 border-white bg-white shadow-[0_24px_50px_-20px_rgba(36,26,18,0.3)] transition-transform duration-500 hover:rotate-0 aspect-4/3">
        <img
          src="/media/mic-kid.jpg"
          alt="Atlet muda memegang mikrofon PROSPECT di sesi Sports Communication"
          loading="lazy"
          width="857"
          height="1063"
          class="h-full w-full object-cover object-[50%_28%]"
          onerror="this.style.display='none'"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-paper/70 via-transparent to-transparent" aria-hidden="true"></div>
        <p class="display absolute bottom-4 left-5 text-xl text-ink/90 italic">Berani Bicara.</p>
      </div>
      <div
        class="absolute -right-3 -bottom-3 hidden rounded-2xl border border-gold/40 bg-paper px-4 py-3 shadow-xl sm:block"
        aria-hidden="true"
      >
        <p class="display text-2xl text-brand-dark">2.175+</p>
        <p class="text-[10px] font-bold tracking-wider text-ink/60 uppercase">atlet teredukasi</p>
      </div>
    </div>

    <div data-reveal="fade" class="order-1 md:order-2">
      <p class="eyebrow text-xs font-bold tracking-[0.2em] text-brand-dark uppercase">Apa itu Sports Communication?</p>
      <h2 class="display mt-3 text-4xl leading-[0.95] sm:text-5xl">
        Skill wajib<br />
        buat <span class="hl-swash text-ink">atlet modern</span>
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-ink/70 sm:text-base">
        <strong class="text-ink">Sports Communication</strong> adalah keterampilan fundamental bagi atlet modern untuk
        berkembang dan naik ke level berikutnya. Melalui <strong class="text-ink">public speaking</strong> dan
        <strong class="text-ink">bahasa Inggris khusus atlet</strong>,
        mereka belajar berkomunikasi dengan percaya diri, menghadapi media, dan membuka peluang lebih besar dalam karier olahraga.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          chips.map((c) => (
            <li class="rounded-full border border-brand/25 bg-brand-soft px-3.5 py-2 text-[11px] font-semibold text-brand-dark sm:text-xs">
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
