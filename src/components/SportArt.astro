---
interface Props {
  variant?: 'stadium' | 'court' | 'net';
  stroke?: string;
  opacity?: number;
  class?: string;
}

const {
  variant = 'stadium',
  stroke = 'currentColor',
  opacity = 0.16,
  class: cls = '',
} = Astro.props;
---

{
  variant === 'court' ? (
    <svg
      class={cls}
      viewBox="0 0 1200 600"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
    >
      <g stroke={stroke} stroke-width="2.5" opacity={opacity}>
        <rect x="40" y="60" width="1120" height="480" rx="16" />
        <line x1="600" y1="60" x2="600" y2="540" />
        <circle cx="600" cy="300" r="105" />
        <circle cx="600" cy="300" r="7" />
        <path d="M340 60 a240 240 0 0 0 0 480" />
        <path d="M860 60 a240 240 0 0 1 0 480" />
        <rect x="40" y="190" width="150" height="220" />
        <rect x="1010" y="190" width="150" height="220" />
        <path d="M190 230 a70 70 0 0 1 0 140" />
        <path d="M1010 230 a70 70 0 0 0 0 140" />
      </g>
      <g stroke={stroke} stroke-width="1.6" opacity={opacity * 0.7}>
        <path d="M0 90 L1200 500" />
        <path d="M0 150 L1200 560" />
        <path d="M0 30 L1200 440" />
      </g>
      <g fill={stroke} opacity={opacity * 0.9}>
        <circle cx="120" cy="120" r="26" />
        <circle cx="1080" cy="480" r="20" />
        <circle cx="1010" cy="110" r="14" />
      </g>
    </svg>
  ) : variant === 'net' ? (
    <svg
      class={cls}
      viewBox="0 0 1200 600"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
    >
      <g stroke={stroke} stroke-width="1.4" opacity={opacity}>
        {Array.from({ length: 26 }).map((_, i) => (
          <line x1={i * 50} y1="0" x2={i * 50 - 300} y2="600" />
        ))}
        {Array.from({ length: 14 }).map((_, i) => (
          <line x1="0" y1={i * 50} x2="1200" y2={i * 50 - 150} />
        ))}
      </g>
      <g stroke={stroke} stroke-width="2.5" opacity={opacity * 1.6}>
        <rect x="60" y="60" width="260" height="180" rx="8" />
        <line x1="60" y1="150" x2="320" y2="150" />
      </g>
    </svg>
  ) : (
    <svg
      class={cls}
      viewBox="0 0 1200 600"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
    >
      <g stroke={stroke} stroke-width="2.5" opacity={opacity}>
        <rect x="40" y="40" width="1120" height="520" rx="18" />
        <line x1="600" y1="40" x2="600" y2="560" />
        <circle cx="600" cy="300" r="112" />
        <circle cx="600" cy="300" r="8" />
        <rect x="40" y="190" width="180" height="220" />
        <rect x="980" y="190" width="180" height="220" />
        <path d="M220 245 a80 80 0 0 1 0 110" />
        <path d="M980 245 a80 80 0 0 0 0 110" />
      </g>
      <g stroke={stroke} stroke-width="2" opacity={opacity * 0.75}>
        <path d="M-60 640 A 380 380 0 0 1 1260 640" />
        <path d="M-60 700 A 460 460 0 0 1 1260 700" />
        <path d="M-60 760 A 540 540 0 0 1 1260 760" />
      </g>
      <g stroke={stroke} stroke-width="1.6" opacity={opacity * 0.6}>
        <path d="M60 130 L420 130" />
        <path d="M60 168 L300 168" />
        <path d="M820 470 L1140 470" />
        <path d="M900 508 L1140 508" />
      </g>
      <g fill={stroke} opacity={opacity * 0.95}>
        <circle cx="180" cy="90" r="26" />
        <circle cx="1010" cy="510" r="22" />
        <circle cx="1090" cy="120" r="14" />
      </g>
    </svg>
  )
}
