---
import { SITE } from '../data/site';
import { waLink } from '../lib/wa';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-ink/8 bg-paper/80 backdrop-blur-xl"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2 py-2 focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none">
      <img
        src="/media/logo-prospect-black.png"
        alt="Prospect"
        width="1000"
        height="233"
        class="h-5 w-auto transition group-hover:-translate-y-0.5 sm:h-6"
      />
      <span class="hidden rounded-sm bg-crimson px-1.5 py-0.5 text-[9px] font-black tracking-wider text-white sm:inline">ASIA</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Navigasi atas">
      {
        [
          { href: '/#program', label: 'Program' },
          { href: '/#workshop', label: 'Workshop' },
          { href: '/berita', label: 'Berita' },
          { href: '/tentang', label: 'Tentang' },
          { href: '/faq', label: 'FAQ' },
        ].map((n) => (
          <a href={n.href} class="group relative py-2 text-sm font-semibold text-ink/70 transition hover:text-ink focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none">
            {n.label}
            <span class="absolute inset-x-0 bottom-1 h-0.5 origin-left scale-x-0 rounded-full bg-gradient-to-r from-brand to-gold transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true" />
          </a>
        ))
      }
    </nav>

    <a
      href={waLink({ source: 'header' })}
      target="_blank"
      rel="noopener noreferrer"
      data-wa-cta="header"
      data-magnetic
      class="btn-pop hidden rounded-xl bg-brand px-4 py-2.5 text-xs font-bold tracking-wide text-ink uppercase shadow-[0_10px_24px_-10px_rgba(255,122,26,0.55)] hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none sm:inline-block"
    >
      Chat WA · {SITE.waDisplay}
    </a>
  </div>
</header>
