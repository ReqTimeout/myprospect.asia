---
import { programs } from '../data/programs';
import { workshops } from '../data/workshops';

interface Props {
  program?: string;
  sumber: string;
  variant?: 'atlet' | 'akademi';
}

const { program = '', sumber, variant = 'atlet' } = Astro.props;

const pilihProgram = !program;
const pilihWorkshop = variant === 'akademi';
const opsi = pilihWorkshop ? workshops.map((w) => w.nama) : programs.map((p) => p.nama);
---

<form
  method="POST"
  action="/api/leads"
  class="card-soft rounded-3xl p-6 focus-within:border-brand/40"
>
  <input type="hidden" name="sumber" value={sumber} />

  {
    variant === 'akademi' ? (
      <>
        <label for="lead-nama" class="block text-xs font-black tracking-widest text-brand-dark uppercase">
          Nama PIC
        </label>
        <input
          id="lead-nama"
          name="nama"
          required
          maxlength="80"
          autocomplete="name"
          placeholder="Nama Anda"
          class="mt-2 w-full rounded-2xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/35 focus:border-brand focus:outline-none"
        />
        <label for="lead-akademi" class="mt-4 block text-xs font-black tracking-widest text-brand-dark uppercase">
          Nama akademi / klub
        </label>
        <input
          id="lead-akademi"
          name="catatan"
          required
          maxlength="120"
          placeholder="cth: Akademi Futsal Margahayu Raya"
          class="mt-2 w-full rounded-2xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/35 focus:border-brand focus:outline-none"
        />
      </>
    ) : (
      <>
        <label for="lead-nama" class="block text-xs font-black tracking-widest text-brand-dark uppercase">
          Nama atlet / wali
        </label>
        <input
          id="lead-nama"
          name="nama"
          required
          maxlength="80"
          autocomplete="name"
          placeholder="Nama Anda"
          class="mt-2 w-full rounded-2xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/35 focus:border-brand focus:outline-none"
        />
      </>
    )
  }

  <label for="lead-wa" class="mt-4 block text-xs font-black tracking-widest text-brand-dark uppercase">
    Nomor WhatsApp
  </label>
  <input
    id="lead-wa"
    name="wa"
    type="tel"
    required
    inputmode="tel"
    autocomplete="tel"
    pattern="[0-9\s+()-]{10,18}"
    placeholder="08xx xxxx xxxx"
    class="mt-2 w-full rounded-2xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/35 focus:border-brand focus:outline-none"
  />

  {
    pilihProgram ? (
      <label for="lead-program" class="mt-4 block text-xs font-black tracking-widest text-brand-dark uppercase">
        Program yang diminati
      </label>
    ) : (
      <input type="hidden" name="program" value={program} />
    )
  }
  {
    pilihProgram && (
      <select
        id="lead-program"
        name="program"
        class="mt-2 w-full rounded-2xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink focus:border-brand focus:outline-none"
      >
        {opsi.map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    )
  }

  <div class="hidden" aria-hidden="true">
    <label>
      Jangan diisi
      <input name="website" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <button
    type="submit"
    data-wa-cta={`form-${sumber}`}
    class="mt-6 flex w-full items-center justify-center gap-2 rounded-2xl bg-brand px-6 py-4 text-sm font-bold text-ink transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none active:scale-95"
  >
    Kirim & lanjut ke WhatsApp ↗
  </button>
  <p class="mt-3 text-center text-[11px] text-ink/50">
    Data Anda hanya dipakai admin untuk membalas via WhatsApp. Admin balas di jam kerja.
  </p>
</form>
