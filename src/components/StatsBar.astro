---
import StatsList from './islands/StatsList.svelte';

const stats = [
  { to: 2175, suffix: '+', label: 'Atlet teredukasi' },
  { to: 25, suffix: '+', label: 'Akademi olahraga' },
  { to: 6, suffix: '', label: 'Coach berpengalaman' },
];
---

<!-- Scoreboard: hitam sebagai bidang, oranye hanya sebagai detail/aksen. -->
<section class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-label="Stats Prospect Asia">
  <div class="relative overflow-hidden rounded-3xl bg-ink-2 shadow-[0_24px_50px_-24px_rgba(27,27,31,0.55)] ring-1 ring-brand">
    <div class="pat-grid-light absolute inset-0 opacity-80" aria-hidden="true"></div>
    <div class="pat-halftone absolute -top-24 -right-16 h-80 w-80 opacity-70 pat-fade-tr" style="--pat-gap: 9px" aria-hidden="true"></div>
    <div class="art-track absolute inset-0 opacity-80" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-brand" aria-hidden="true"></div>

    <!-- Baris marquee "Scoreboard" dihapus: rangkap dengan ticker ribbon di atas hero. -->
    <div class="relative p-3 sm:p-4">
      <StatsList client:visible stats={stats} />
    </div>
  </div>
</section>
