---
import StatsList from './islands/StatsList.svelte';

const stats = [
  { to: 2175, suffix: '+', label: 'Atlet teredukasi' },
  { to: 25, suffix: '+', label: 'Akademi olahraga' },
  { to: 6, suffix: '', label: 'Coach berpengalaman' },
];
---

<section class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-label="Stats Prospect Asia">
  <div class="absolute inset-x-4 -top-5 h-44 overflow-hidden rounded-3xl bg-gradient-to-br from-brand via-brand to-brand-dark shadow-[0_24px_50px_-20px_rgba(255,122,26,0.75)] sm:inset-x-6" aria-hidden="true"></div>
  <div class="art-stripes-light absolute inset-x-4 -top-5 h-44 rounded-3xl opacity-50 sm:inset-x-6" aria-hidden="true"></div>
  <div class="art-track absolute inset-x-4 -top-5 h-44 opacity-70 sm:inset-x-6" aria-hidden="true"></div>
  <div class="relative mt-2">
    <StatsList client:visible stats={stats} />
  </div>
</section>
