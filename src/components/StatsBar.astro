---
import StatsList from './islands/StatsList.svelte';

const stats = [
  { to: 2175, suffix: '+', label: 'Atlet teredukasi' },
  { to: 25, suffix: '+', label: 'Akademi olahraga' },
  { to: 6, suffix: '', label: 'Coach berpengalaman' },
];
---

<!-- Statistik: tiga angka besar dengan garis pemisah, tanpa ornamen.
     Papan LED seven-segment sudah dihapus (klien: "jelek sekali, kayak AI"). -->
<section
  class="relative border-y border-ink/10 bg-paper"
  aria-label="Stats Prospect Asia"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <StatsList client:visible stats={stats} />
  </div>
</section>
