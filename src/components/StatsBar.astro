---
import StatsList from './islands/StatsList.svelte';
import TickerRibbon from './TickerRibbon.astro';

const stats = [
  { to: 2175, suffix: '+', label: 'Atlet teredukasi' },
  { to: 25, suffix: '+', label: 'Akademi olahraga' },
  { to: 6, suffix: '', label: 'Coach berpengalaman' },
];

const ticker = [
  '2.175+ atlet teredukasi',
  '25 akademi mitra',
  '6 coach berpengalaman',
  'Public speaking khusus atlet',
  'English for athletes',
  'Online · jadwal fleksibel',
];
---

<section class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-label="Stats Prospect Asia">
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand via-brand to-brand-dark shadow-[0_24px_50px_-20px_rgba(255,122,26,0.75)]">
    <div class="art-stripes-light absolute inset-0 opacity-45" aria-hidden="true"></div>
    <div class="art-track absolute inset-0 opacity-60" aria-hidden="true"></div>

    <div class="relative flex flex-col gap-2 border-b border-white/25 bg-ink/85 px-3 py-2 text-white sm:flex-row sm:items-center sm:gap-3">
      <span class="flex shrink-0 items-center gap-1.5">
        <span class="h-2 w-2 animate-pulse rounded-full bg-brand"></span>
        <span class="text-[10px] font-black tracking-[0.2em] text-white uppercase">Scoreboard</span>
      </span>
      <span class="hidden h-3 w-px shrink-0 bg-white/25 sm:block"></span>
      <TickerRibbon items={ticker} speed={30} tone="none" class="sm:flex-1" />
    </div>

    <div class="relative p-3 sm:p-4">
      <StatsList client:visible stats={stats} />
    </div>
  </div>
</section>