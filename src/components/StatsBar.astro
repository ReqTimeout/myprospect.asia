---
import StatsList from './islands/StatsList.svelte';
import TickerRibbon from './TickerRibbon.astro';

const stats = [
  { to: 2175, suffix: '+', label: 'Atlet teredukasi' },
  { to: 25, suffix: '+', label: 'Akademi olahraga' },
  { to: 6, suffix: '', label: 'Coach berpengalaman' },
];

const ticker = [
  '2.175+ atlet teredukasi',
  '25 akademi mitra',
  '6 coach berpengalaman',
  'Public speaking khusus atlet',
  'English for athletes',
  'Online · jadwal fleksibel',
];
---

<!-- Scoreboard: hitam sebagai bidang, oranye hanya sebagai detail/aksen. -->
<section class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-label="Stats Prospect Asia">
  <div class="relative overflow-hidden rounded-3xl bg-ink-2 shadow-[0_24px_50px_-24px_rgba(36,26,18,0.55)] ring-1 ring-brand/30">
    <div class="pat-grid-light absolute inset-0 opacity-80" aria-hidden="true"></div>
    <div class="pat-halftone absolute -top-24 -right-16 h-80 w-80 opacity-70 pat-fade-tr" style="--pat-gap: 9px" aria-hidden="true"></div>
    <div class="pat-noise-light absolute inset-0" aria-hidden="true"></div>
    <div class="art-track absolute inset-0 opacity-80" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand to-transparent" aria-hidden="true"></div>

    <div class="relative flex flex-col gap-2 border-b border-white/12 bg-ink-2/85 px-3 py-2 text-white sm:flex-row sm:items-center sm:gap-3">
      <span class="flex shrink-0 items-center gap-1.5">
        <span class="h-2 w-2 animate-pulse rounded-full bg-brand"></span>
        <span class="text-[10px] font-black tracking-[0.2em] text-white uppercase">Scoreboard</span>
      </span>
      <span class="hidden h-3 w-px shrink-0 bg-white/25 sm:block"></span>
      <TickerRibbon items={ticker} speed={30} tone="none" class="sm:flex-1" />
    </div>

    <div class="relative p-3 sm:p-4">
      <StatsList client:visible stats={stats} />
    </div>
  </div>
</section>
