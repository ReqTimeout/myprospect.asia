---
import '@fontsource-variable/plus-jakarta-sans/index.css';
import '@fontsource/anton/index.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ogBg from '../assets/generated/a2-og-bg.jpg';
import { jsonLd } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Prospect Asia — Sports Communication Program untuk atlet modern. Public speaking & bahasa Inggris khusus atlet, via WhatsApp.',
  schema,
} = Astro.props;

const ogImage = await getImage({ src: ogBg, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="id-ID">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffcf7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <title>{title}</title>
  </head>
  <body class="min-h-dvh antialiased">
    <div class="page-curtain" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.addEventListener('pa:popup_open', function () {
        window.gtag('event', 'popup_open');
      });
      function beacon(path, data) {
        try {
          if (navigator.sendBeacon) {
            navigator.sendBeacon(path, new Blob([JSON.stringify(data)], { type: 'application/json' }));
          }
        } catch (e) {}
      }
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-wa-cta]') : null;
        if (!el || el.tagName !== 'A') return;
        var slug = el.getAttribute('data-wa-cta') || 'unknown';
        window.gtag('event', 'wa_click', { cta: slug });
        beacon('/api/click', { slug: slug });
      });
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.getAttribute || form.getAttribute('action') !== '/api/leads') return;
        var btn = form.querySelector('[data-wa-cta]');
        window.gtag('event', 'lead_submit', { cta: btn ? btn.getAttribute('data-wa-cta') : 'form' });
        if (btn) beacon('/api/click', { slug: btn.getAttribute('data-wa-cta') });
      });
      fetch('/api/settings')
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (s) {
          var id = s && s.ga4_id;
          if (!id || !/^G-[A-Z0-9]{6,20}$/.test(id)) return;
          var el = document.createElement('script');
          el.async = true;
          el.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
          document.head.appendChild(el);
          window.gtag('config', id);
        })
        .catch(function () {});
      // jaring pengaman: kalau modul fx.ts gagal dimuat, konten reveal tetap terlihat
      setTimeout(function () {
        var revs = document.querySelectorAll('[data-reveal]:not(.rd-in)');
        if (!revs.length) return;
        var limit = window.innerHeight * 0.92;
        for (var i = 0; i < revs.length; i++) {
          var r = revs[i].getBoundingClientRect();
          if (r.top < limit && r.bottom > 0) revs[i].classList.add('rd-in');
        }
      }, 2200);
    </script>
  </body>
  <script src="../scripts/fx.ts"></script>
</html>
