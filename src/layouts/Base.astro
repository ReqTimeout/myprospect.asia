---
import '@fontsource-variable/plus-jakarta-sans/index.css';
import '@fontsource/anton/index.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ogBg from '../assets/generated/a2-og-bg.jpg';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Prospect Asia — Sports Communication Program untuk atlet modern. Public speaking & bahasa Inggris khusus atlet, via WhatsApp.',
} = Astro.props;

const ogImage = await getImage({ src: ogBg, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="id-ID">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.addEventListener('pa:popup_open', function () {
        window.gtag('event', 'popup_open');
      });
      function beacon(path, data) {
        try {
          if (navigator.sendBeacon) {
            navigator.sendBeacon(path, new Blob([JSON.stringify(data)], { type: 'application/json' }));
          }
        } catch (e) {}
      }
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-wa-cta]') : null;
        if (!el || el.tagName !== 'A') return;
        var slug = el.getAttribute('data-wa-cta') || 'unknown';
        window.gtag('event', 'wa_click', { cta: slug });
        beacon('/api/click', { slug: slug });
      });
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.getAttribute || form.getAttribute('action') !== '/api/leads') return;
        var btn = form.querySelector('[data-wa-cta]');
        window.gtag('event', 'lead_submit', { cta: btn ? btn.getAttribute('data-wa-cta') : 'form' });
        if (btn) beacon('/api/click', { slug: btn.getAttribute('data-wa-cta') });
      });
    </script>
  </body>
</html>
